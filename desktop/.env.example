# Variables del build de la app de escritorio. Lo que no esté acá se toma de
# server/.env (de ahí salen las de Supabase Auth, sin duplicarlas).

# A dónde le habla la app. Es la única variable que NO puede salir del server:
# en desarrollo la dashboard pide "/api" al proxy de Vite, y adentro de la app
# no hay proxy — "/api" sería app://conext/api, que no existe.
VITE_API_URL=https://api.conext.lat

# Solo si querés que la app apunte a otro Supabase que el del server.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
