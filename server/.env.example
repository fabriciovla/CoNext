PORT=3001
NODE_ENV=development

# Postgres. En Windows no hay Docker ni psql local, así que lo más rápido es una
# base hospedada (Supabase, Neon, Railway). En Supabase: Project Settings →
# Database → Connection string (URI), con "?sslmode=require".
# El server tiene que entrar con el rol `postgres` (o `service_role`): las
# políticas RLS de cada cliente no aplican a ese rol, y el webhook de Meta no
# trae un usuario logueado. La dashboard, cuando hable directo con Supabase,
# usa la anon/authenticated key y ahí sí corta el RLS.
DATABASE_URL=postgresql://usuario:clave@host/base?sslmode=require

# Clave con la que se cifran los tokens de WhatsApp de cada cliente antes de
# guardarlos. Sin esto no se puede conectar ningún número.
# Generala con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# API key del cliente con el que trabaja la dashboard local. Ya no es una clave
# compartida del server: cada tenant tiene la suya y de ella sale de quién son
# los datos que se ven. La devuelve `node scripts/createTenant.js "<nombre>"`
# una sola vez — en la base queda solo el hash.
API_KEY=

# Google Gemini (free tier — get a key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# "-latest" aliases avoid hardcoding a pinned model version that Google can
# retire for new API keys (gemini-2.5-flash itself already 404s for new users).
AI_MODEL=gemini-flash-latest
AI_ROUTER_MODEL=gemini-flash-lite-latest

# WhatsApp Cloud API (Meta, sin BSP intermediario) — https://developers.facebook.com
#
# WA_ACCESS_TOKEN y WA_PHONE_NUMBER_ID ya NO van acá: son por cliente y viven en
# la tabla `tenants` (el token, cifrado). Las puebla Embedded Signup en el alta.
# Un token global mandaría los mensajes de todos los negocios desde el mismo
# número.
WA_GRAPH_VERSION=v25.0
# Solo desarrollo, dejar vacío en producción. La allow list del número de prueba
# compara el string crudo, así que un wa_id argentino (549…) no matchea el número
# cargado en la consola (54…15…). Formato: "waId:destino,waId:destino".
WA_DEV_RECIPIENT_MAP=

# Webhook de Meta — una sola URL para todos los clientes. Estos dos sí son
# globales: identifican a *tu* app, no a cada negocio.
# META_WEBHOOK_VERIFY_TOKEN lo inventás vos y lo repetís en la consola de Meta;
# META_APP_SECRET está en Configuración de la app > Básica.
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=

# Embedded Signup: el botón donde el cliente conecta su propio WhatsApp.
#
# META_APP_ID  — Configuración de la app > Básica (es público, lo ve el browser).
# META_CONFIG_ID — el id de la configuración de "Inicio de sesión de Facebook
#   para Empresas" que se crea en la consola. NO es el id de la app: son dos
#   números distintos y confundirlos da un error de Meta que no explica nada.
META_APP_ID=
META_CONFIG_ID=

# Segundo factor del número, lo elegís vos: 6 dígitos, siempre el mismo. Se usa
# al registrar cada número de cliente en Cloud API. Si cambia, los números ya
# registrados no se pueden volver a registrar sin desactivar la verificación en
# dos pasos desde el Business Manager del cliente.
WA_REGISTER_PIN=
