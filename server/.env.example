PORT=3001
DB_PATH=./data/wsp-crm.db
NODE_ENV=development

# Clave de la API del CRM: todo salvo /webhooks la exige en el header x-api-key.
# Sin esto, publicar el server por un túnel deja la API entera abierta a internet.
# Generá una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=

# Google Gemini (free tier — get a key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# "-latest" aliases avoid hardcoding a pinned model version that Google can
# retire for new API keys (gemini-2.5-flash itself already 404s for new users).
AI_MODEL=gemini-flash-latest
AI_ROUTER_MODEL=gemini-flash-lite-latest

# WhatsApp Cloud API (Meta, sin BSP intermediario) — https://developers.facebook.com
# WA_PHONE_NUMBER_ID sale de WhatsApp > Configuración de la API; el número de
# prueba que da Meta ya sirve para desarrollo. El token temporal de esa misma
# pantalla dura 24h: para algo estable, generá un token de usuario del sistema
# en Business Settings con los permisos whatsapp_business_messaging + _management.
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_GRAPH_VERSION=v25.0
# Solo desarrollo, dejar vacío en producción. La allow list del número de prueba
# compara el string crudo, así que un wa_id argentino (549…) no matchea el número
# cargado en la consola (54…15…). Formato: "waId:destino,waId:destino".
WA_DEV_RECIPIENT_MAP=

# Webhook de Meta — el mismo endpoint (/webhooks/meta) recibe WhatsApp e Instagram.
# META_WEBHOOK_VERIFY_TOKEN lo inventás vos y lo repetís en la consola de Meta;
# META_APP_SECRET está en Configuración de la app > Básica.
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=

# Instagram Messaging — opcional, todavía dormido
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=
