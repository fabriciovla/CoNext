PORT=3001
NODE_ENV=development

# Postgres. En Windows no hay Docker ni psql local, así que lo más rápido es una
# base hospedada (Supabase, Neon, Railway). En Supabase: Project Settings →
# Database → Connection string (URI), con "?sslmode=require".
#
# OJO con cuál de las dos cadenas copiás. La directa
# (db.<ref>.supabase.co) hoy resuelve **solo por IPv6**: en una máquina sin IPv6
# —la mayoría de las conexiones hogareñas— Node no la resuelve y el server muere
# al arrancar con `getaddrinfo ENOTFOUND`. La que sirve es la del pooler, que
# tiene IPv4:
#   postgresql://postgres.<ref>:<clave>@aws-0-<region>.pooler.supabase.com:5432/postgres
# El usuario lleva el ref del proyecto pegado (postgres.<ref>), y el 5432 del
# pooler es session mode, que se comporta como una conexión normal. El 6543 es
# transaction mode y también anda, pero no hace falta para un server que
# mantiene un pool propio.
# El server tiene que entrar con el rol `postgres` (o `service_role`): las
# políticas RLS de cada cliente no aplican a ese rol, y el webhook de Meta no
# trae un usuario logueado. La dashboard, cuando hable directo con Supabase,
# usa la anon/authenticated key y ahí sí corta el RLS.
DATABASE_URL=postgresql://usuario:clave@host/base?sslmode=require

# Clave con la que se cifran los tokens de WhatsApp de cada cliente antes de
# guardarlos. Sin esto no se puede conectar ningún número.
# Generala con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# API key del cliente con el que trabaja la dashboard local. Ya no es una clave
# compartida del server: cada tenant tiene la suya y de ella sale de quién son
# los datos que se ven. La devuelve `node scripts/createTenant.js "<nombre>"`
# una sola vez — en la base queda solo el hash.
API_KEY=

# Login social (Google, GitHub, Microsoft, Apple) — Supabase Auth.
# Son públicas a propósito (anon key): van al browser. NO uses la service_role.
# En Authentication → Providers, encendé cada uno y cargá el Client ID/Secret.
# Redirect URLs: http://localhost:5173/**  y  https://conext.lat/app/**
# Y `conext://auth` para la app de escritorio: ahí el proveedor no puede volver
# a una URL de la web (la página vive en app://conext, que un navegador no
# abre), así que vuelve por el esquema que registra la app. Si esa no está en la
# lista, Supabase manda a la Site URL y el ingreso se pierde en el navegador.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Gemini (free tier — get a key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# "-latest" aliases avoid hardcoding a pinned model version that Google can
# retire for new API keys (gemini-2.5-flash itself already 404s for new users).
AI_MODEL=gemini-flash-latest
AI_ROUTER_MODEL=gemini-flash-lite-latest

# WhatsApp Cloud API (Meta, sin BSP intermediario) — https://developers.facebook.com
#
# WA_ACCESS_TOKEN y WA_PHONE_NUMBER_ID ya NO van acá: son por cliente y viven en
# la tabla `tenants` (el token, cifrado). Las puebla Embedded Signup en el alta.
# Un token global mandaría los mensajes de todos los negocios desde el mismo
# número.
WA_GRAPH_VERSION=v26.0
# Solo desarrollo, dejar vacío en producción. La allow list del número de prueba
# compara el string crudo, así que un wa_id argentino (549…) no matchea el número
# cargado en la consola (54…15…). Formato: "waId:destino,waId:destino".
WA_DEV_RECIPIENT_MAP=

# Webhook de Meta — una sola URL para todos los clientes. Estos dos sí son
# globales: identifican a *tu* app, no a cada negocio.
# META_WEBHOOK_VERIFY_TOKEN lo inventás vos y lo repetís en la consola de Meta;
# META_APP_SECRET está en Configuración de la app > Básica.
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=

# Embedded Signup: el botón donde el cliente conecta su propio WhatsApp.
#
# META_APP_ID  — Configuración de la app > Básica (es público, lo ve el browser).
# META_CONFIG_ID — el id de la configuración de "Inicio de sesión de Facebook
#   para Empresas" que se crea en la consola. NO es el id de la app: son dos
#   números distintos y confundirlos da un error de Meta que no explica nada.
META_APP_ID=
META_CONFIG_ID=

# Instagram y Messenger no agregan ninguna variable: usan META_APP_ID y
# META_APP_SECRET, los mismos de arriba. No llevan config_id porque no son
# Embedded Signup — el cliente elige su Página en nuestra pantalla, no adentro
# del popup de Meta. Lo que sí hay que hacer una vez en la consola es suscribir
# la app a los webhooks de "messages" para los productos Messenger e Instagram,
# que es lo que hace que los mensajes lleguen a la misma URL que los de WhatsApp.

# Segundo factor del número, lo elegís vos: 6 dígitos, siempre el mismo. Se usa
# al registrar cada número de cliente en Cloud API. Si cambia, los números ya
# registrados no se pueden volver a registrar sin desactivar la verificación en
# dos pasos desde el Business Manager del cliente.
WA_REGISTER_PIN=

# ---------------------------------------------------------------------------
# Publicado (Railway). En local no hace falta ninguna de estas.
# ---------------------------------------------------------------------------

# Quién puede llamar a la API desde un navegador. La dashboard y la API viven en
# dominios distintos una vez publicadas, así que sin esto el navegador bloquea
# todo. Se separan con coma y van sin barra final. Vacío = cualquiera, que sirve
# en desarrollo y no puede quedar así en producción.
#
# `app://conext` es la app de escritorio (desktop/). No es un dominio: es el
# esquema propio con el que Electron sirve la dashboard desde el disco, y
# Chromium lo manda en el Origin igual que a cualquier otro. Sin él la app abre,
# dibuja la pantalla entera y después cada request muere en CORS.
CORS_ORIGINS=https://conext.lat,app://conext

# Dónde escribir los adjuntos. En el host, la ruta del volumen montado: el resto
# del disco se rehace en cada deploy y Meta borra su copia a los 30 días, así
# que ahí se perderían los archivos viejos del hilo. Vacío = server/uploads.
UPLOADS_DIR=/data/uploads

# Verificación de la sesión de la dashboard. Son las mismas de VITE_SUPABASE_*
# de más arriba (el server las lee de cualquiera de los dos nombres); van
# repetidas sin el prefijo porque en el host no hay build de Vite que las lea.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Dodo Payments: API key del dashboard (Developer > API Keys), secreto de
# firma del webhook, y contra qué entorno pega el server (test | live).
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_MODE=test
