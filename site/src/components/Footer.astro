---
import { LogoMarca } from './Logo.jsx'
import LangSwitch from './LangSwitch.astro'
import { EMAIL, GITHUB_URL, WHATSAPP_URL } from '../config'
import { t, pathFor } from '../i18n/utils'

const { lang } = Astro.props
const copy = t(lang)
const f = copy.footer
const l = f.links
const c = f.columnas
const pg = copy.producto.paginas
const home = pathFor(lang, '/')

const claseEnlace =
  'text-[13.5px] text-ink-primary transition-colors duration-200 hover:text-violet'

const COLUMNAS = [
  {
    titulo: c.producto,
    enlaces: [
      { href: pathFor(lang, '/producto/api-whatsapp'), label: pg['api-whatsapp'].nombre },
      { href: pathFor(lang, '/producto/equipo'), label: pg.equipo.nombre },
      { href: pathFor(lang, '/producto/datos'), label: pg.datos.nombre },
      { href: pathFor(lang, '/precios'), label: l.precios },
    ],
  },
  {
    titulo: c.atencion,
    enlaces: [
      { href: pathFor(lang, '/producto/bandeja'), label: pg.bandeja.nombre },
      { href: pathFor(lang, '/producto/carpetas'), label: pg.carpetas.nombre },
      { href: pathFor(lang, '/producto/notas'), label: pg.notas.nombre },
    ],
  },
  {
    titulo: c.inteligencia,
    enlaces: [
      { href: pathFor(lang, '/producto/agentes'), label: pg.agentes.nombre },
      { href: pathFor(lang, '/producto/borrador'), label: pg.borrador.nombre },
      { href: pathFor(lang, '/producto/clasificacion'), label: pg.clasificacion.nombre },
    ],
  },
  {
    titulo: c.operacion,
    enlaces: [
      { href: pathFor(lang, '/producto/catalogo'), label: pg.catalogo.nombre },
      { href: pathFor(lang, '/producto/metricas'), label: pg.metricas.nombre },
      { href: pathFor(lang, '/producto/stock'), label: pg.stock.nombre },
    ],
  },
  {
    titulo: c.recursos,
    enlaces: [
      { href: pathFor(lang, '/#funciones'), label: l.funciones },
      { href: pathFor(lang, '/#como-funciona'), label: l.comoFunciona },
      { href: pathFor(lang, '/#preguntas'), label: l.preguntas },
      { href: pathFor(lang, '/ayuda'), label: l.ayuda },
      { href: pathFor(lang, '/ayuda#facturacion'), label: l.facturacion },
      { href: pathFor(lang, '/ayuda#cuentas'), label: l.cuentas },
      { href: pathFor(lang, '/ayuda#seguridad'), label: l.seguridad },
      { href: pathFor(lang, '/ayuda#datos'), label: l.datos },
    ],
  },
  {
    titulo: c.general,
    enlaces: [
      { href: WHATSAPP_URL, label: l.demo, externo: true },
      { href: pathFor(lang, '/login'), label: l.login },
      { href: GITHUB_URL, label: 'GitHub', externo: true },
    ],
  },
]

const LEGALES = [
  { href: pathFor(lang, '/ayuda'), label: l.legalesAyuda },
  { href: `mailto:${EMAIL}`, label: EMAIL },
  { href: pathFor(lang, '/privacidad'), label: l.privacidad },
  { href: pathFor(lang, '/terminos'), label: l.terminos },
  { href: pathFor(lang, '/eliminar-datos'), label: l.eliminar },
]
---

<footer class="border-t border-tint/10">
  <div class="mx-auto w-full max-w-6xl px-6 py-16 sm:py-20">
    <div class="flex flex-col gap-12 lg:flex-row lg:gap-16">
      <a
        href={home}
        aria-label="conext"
        class="shrink-0 text-ink-primary transition-opacity duration-200 hover:opacity-80"
      >
        <LogoMarca className="h-8 w-auto" />
      </a>

      <nav
        aria-label={f.nav}
        class="grid min-w-0 flex-1 grid-cols-2 gap-x-8 gap-y-10 sm:grid-cols-3 xl:grid-cols-6"
      >
        {
          COLUMNAS.map((columna) => (
            <div class="min-w-0">
              <p class="text-[13.5px] font-medium text-ink-primary">{columna.titulo}</p>
              <ul class="mt-3.5 space-y-2.5">
                {columna.enlaces.map(({ href, label, externo }) => (
                  <li>
                    <a
                      href={href}
                      class={claseEnlace}
                      {...(externo ? { target: '_blank', rel: 'noreferrer' } : {})}
                    >
                      {label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>

    <div
      class="mt-16 flex flex-col gap-6 border-t border-tint/10 pt-8 sm:mt-20 xl:flex-row xl:items-start xl:justify-between"
    >
      <ul class="flex flex-wrap items-center gap-x-8 gap-y-2.5">
        {
          LEGALES.map(({ href, label }) => (
            <li>
              <a href={href} class={claseEnlace}>
                {label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="flex shrink-0 flex-col gap-4 xl:items-end">
        <LangSwitch lang={lang} />
        <div class="text-[13px] text-ink-muted xl:text-right">
          <p>
            Copyright © {new Date().getFullYear()} conext. {f.copyright}
          </p>
          <p class="mt-1">{f.meta}</p>
        </div>
      </div>
    </div>
  </div>
</footer>
