---
import { BarraMock, AvatarCanal, Foto } from './AppMock.jsx'
import {
  IconArrowIn,
  IconArrowOut,
  IconBolt,
  IconCompose,
  IconMic,
  IconPaperclip,
  IconSearch,
  IconSend,
  IconSmile,
  IconSparkles,
} from '../icons.jsx'

// Película de la bandeja: la IA deja el borrador, una persona lo manda.
//
// Antes era la captura de `public/` con recuadros de color en porcentajes
// encima. No funcionaba: cada porcentaje estaba calibrado contra un ancho de
// 1918 px, así que en cualquier otro tamaño el cursor apuntaba al aire y las
// tapas quedaban corridas de la fila que tapaban — y el texto de la foto, a la
// escala del contenedor, era ilegible.
//
// Acá la bandeja es DOM de verdad (la misma barra que el hero, importada) y el
// cursor se mueve midiendo el elemento al que va con getBoundingClientRect. No
// hay coordenada escrita a mano en ninguna parte: le acierta al botón a
// cualquier ancho, y el texto se lee nítido porque es texto.

const RESPUESTAS = {
  martin:
    'Sí, aceptamos transferencia. Te paso los datos y en cuanto me envíes el comprobante lo despacho.',
  laura: 'Sí, las dos juntas quedan en $102.000. Si te cierra te armo el pedido.',
}

// Tres chats, dos modos: Martín y Laura tocan plata y esperan que alguien
// mande el borrador; el de Nicolás es una pregunta de siempre y el agente ya
// la contestó solo. El modo va en la cabecera de cada hilo: es el interruptor
// del que habla el texto de arriba.
const HILOS = [
  {
    clave: 'martin',
    nombre: 'Martín Ríos',
    telefono: '+54 9 11 5555-0142',
    agente: 'Ventas',
    modo: 'borrador',
    respuesta: RESPUESTAS.martin,
    mensajes: [
      // `viejo` es lo que se cae abajo de lg: sin la lista al costado la
      // columna queda angosta, cada burbuja pasa a tres renglones y el hilo
      // entero no entra. El pedido y la respuesta son los que cuentan.
      { de: 'cliente', viejo: true, texto: 'Hola, ¿tienen la campera de jean en talle M?' },
      {
        de: 'agente',
        autor: 'Ventas',
        viejo: true,
        texto: 'Sí, nos queda una en M. Sale $48.900 y si la pides hoy sale para tu casa mañana.',
      },
      { de: 'cliente', texto: 'Buenísimo. ¿Aceptan transferencia?' },
    ],
  },
  {
    clave: 'laura',
    nombre: 'Laura Gómez',
    telefono: '+54 9 11 4444-0087',
    agente: 'Ventas',
    modo: 'borrador',
    respuesta: RESPUESTAS.laura,
    mensajes: [
      { de: 'cliente', texto: 'Quiero la de jean y la de cuero. ¿Me hacen precio por las dos?' },
    ],
  },
  {
    clave: 'nicolas',
    nombre: 'Nicolás Paz',
    telefono: '+54 9 351 444-0198',
    agente: 'Envíos',
    modo: 'automático',
    mensajes: [
      { de: 'cliente', texto: 'Hola! ¿Hacen envíos a Córdoba?' },
      {
        de: 'agente',
        autor: 'Envíos',
        nota: 'enviado solo',
        texto: 'Sí, enviamos a todo el país por Andreani. A Córdoba llega en 48 h y el envío sale $6.200.',
      },
    ],
  },
]

// Una sola fila quieta al fondo: con cuatro nombres la lista se lee como
// bandeja y no como el guión de la película.
const RESTO = [{ clave: 'carla', nombre: 'Carla Vega', hora: '3 h', texto: 'Gracias! Cualquier cosa escribo' }]
---

<div
  class="film relative h-[440px] w-full overflow-hidden bg-surface-page text-left sm:h-[500px] lg:h-[560px]"
  data-film
  data-escena="martin"
  data-sugerencia="si"
  data-enviado=""
  data-cursor="no"
  aria-hidden="true"
>
  <div class="flex h-full">
    <BarraMock className="hidden w-[212px] lg:flex" />

    {/* ------------------------------------------------------------------ */}
    {/* Lista                                                               */}
    {/* ------------------------------------------------------------------ */}
    <section class="hidden w-[304px] shrink-0 flex-col border-r border-tint/[0.07] bg-surface-card lg:flex">
      <header class="shrink-0 px-3 pt-2.5">
        <div class="flex items-center justify-between border-b border-tint/[0.07]">
          <div class="flex items-center gap-4">
            <span class="relative pb-2.5 pt-1 text-[13.5px] font-medium text-violet">
              Chats
              <span class="absolute -bottom-px left-0 h-[2px] w-full rounded-full bg-violet"></span>
            </span>
            <span class="pb-2.5 pt-1 text-[13.5px] font-medium text-ink-muted">Llamadas</span>
          </div>
          <div class="flex gap-0.5 pb-1.5 text-ink-muted">
            <span class="flex h-7 w-7 items-center justify-center"><IconCompose size={15} /></span>
            <span class="flex h-7 w-7 items-center justify-center"><IconSearch size={15} /></span>
          </div>
        </div>
        <p class="py-2 text-[12.5px] text-ink-muted">Abiertas, recientes</p>
      </header>

      <div class="min-h-0 flex-1 space-y-px overflow-hidden px-2 pb-2">
        {/* Martín y Laura cambian al mandarse: se les va el pendiente y el
            último mensaje pasa a ser el que salió. Nicolás no: el agente ya
            lo contestó solo y no lleva etiqueta — en la bandeja real las
            etiquetas las pone una persona, no el tema del agente. */}
        <div class="film-fila film-fila-martin flex items-start gap-2.5 rounded-lg px-2 py-2.5" data-t="fila-martin">
          <AvatarCanal size={38} />
          <div class="min-w-0 flex-1">
            <div class="flex items-baseline justify-between gap-2">
              <p class="truncate text-[13.5px] font-medium text-ink-primary">Martín Ríos</p>
              <span class="film-antes shrink-0 text-[11.5px] tabular-nums text-ink-faint">2 min</span>
              <span class="film-despues shrink-0 text-[11.5px] tabular-nums text-ink-faint">ahora</span>
            </div>
            <div class="film-antes mt-0.5 flex items-center gap-1.5">
              <IconArrowIn size={12} className="shrink-0 text-[#25d366]" />
              <p class="min-w-0 flex-1 truncate text-[12.5px] text-ink-muted">¿Aceptan transferencia?</p>
              <span
                class="flex h-[18px] min-w-[18px] shrink-0 items-center justify-center rounded-full bg-status-warning px-1 text-[10.5px] font-bold text-status-ink"
              >
                1
              </span>
            </div>
            <div class="film-despues mt-0.5 flex items-center gap-1.5">
              <IconArrowOut size={12} className="shrink-0 text-ink-faint" />
              <p class="min-w-0 flex-1 truncate text-[12.5px] text-ink-muted">{RESPUESTAS.martin}</p>
            </div>
          </div>
        </div>

        <div class="film-fila film-fila-laura flex items-start gap-2.5 rounded-lg px-2 py-2.5" data-t="fila-laura">
          <AvatarCanal size={38} />
          <div class="min-w-0 flex-1">
            <div class="flex items-baseline justify-between gap-2">
              <p class="truncate text-[13.5px] font-medium text-ink-primary">Laura Gómez</p>
              <span class="film-antes shrink-0 text-[11.5px] tabular-nums text-ink-faint">9 min</span>
              <span class="film-despues shrink-0 text-[11.5px] tabular-nums text-ink-faint">ahora</span>
            </div>
            <div class="film-antes mt-0.5 flex items-center gap-1.5">
              <IconArrowIn size={12} className="shrink-0 text-[#25d366]" />
              <p class="min-w-0 flex-1 truncate text-[12.5px] text-ink-muted">¿Me hacen precio por las dos?</p>
              <span
                class="flex h-[18px] min-w-[18px] shrink-0 items-center justify-center rounded-full bg-status-warning px-1 text-[10.5px] font-bold text-status-ink"
              >
                1
              </span>
            </div>
            <div class="film-despues mt-0.5 flex items-center gap-1.5">
              <IconArrowOut size={12} className="shrink-0 text-ink-faint" />
              <p class="min-w-0 flex-1 truncate text-[12.5px] text-ink-muted">{RESPUESTAS.laura}</p>
            </div>
          </div>
        </div>

        <div class="film-fila film-fila-nicolas flex items-start gap-2.5 rounded-lg px-2 py-2.5" data-t="fila-nicolas">
          <AvatarCanal size={38} />
          <div class="min-w-0 flex-1">
            <div class="flex items-baseline justify-between gap-2">
              <p class="truncate text-[13.5px] font-medium text-ink-primary">Nicolás Paz</p>
              <span class="shrink-0 text-[11.5px] tabular-nums text-ink-faint">14 min</span>
            </div>
            <div class="mt-0.5 flex items-center gap-1.5">
              <IconArrowOut size={12} className="shrink-0 text-ink-faint" />
              <p class="min-w-0 flex-1 truncate text-[12.5px] text-ink-muted">
                Sí, enviamos a todo el país por Andreani.
              </p>
            </div>
          </div>
        </div>

        {
          RESTO.map(({ clave, nombre, hora, texto }) => (
            <div class="film-fila flex items-start gap-2.5 rounded-lg px-2 py-2.5" data-t={`fila-${clave}`}>
              <AvatarCanal size={38} />
              <div class="min-w-0 flex-1">
                <div class="flex items-baseline justify-between gap-2">
                  <p class="truncate text-[13.5px] font-medium text-ink-primary">{nombre}</p>
                  <span class="shrink-0 text-[11.5px] tabular-nums text-ink-faint">{hora}</span>
                </div>
                <div class="mt-0.5 flex items-center gap-1.5">
                  <IconArrowOut size={12} className="shrink-0 text-ink-faint" />
                  <p class="min-w-0 flex-1 truncate text-[12.5px] text-ink-muted">{texto}</p>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    {/* ------------------------------------------------------------------ */}
    {/* Conversación                                                        */}
    {/* ------------------------------------------------------------------ */}
    <section class="flex min-w-0 flex-1 flex-col bg-surface-card">
      {/* Los hilos se apilan y se cruzan por opacidad: así el que entra no
          empuja al composer mientras aparece. */}
      <div class="relative min-h-0 flex-1">
        {
          HILOS.map(({ clave, nombre, telefono, agente, modo, mensajes, respuesta }) => (
            <div
              class:list={['film-hilo', `film-hilo-${clave}`, 'absolute inset-0 flex flex-col']}
              data-respuesta={respuesta}
            >
              <header
                class="flex shrink-0 items-center gap-2.5 border-b border-tint/[0.07] px-4 py-2.5 sm:px-5"
              >
                <Foto size={34} />
                <div class="min-w-0 flex-1 leading-tight">
                  <p class="truncate text-[14px] font-medium text-ink-primary">{nombre}</p>
                  <p class="truncate text-[11.5px] tabular-nums text-ink-muted">{telefono}</p>
                </div>
                <span
                  class="shrink-0 rounded-full border border-violet/20 bg-violet-soft px-2.5 py-1 text-[11.5px] text-violet"
                >
                  {agente}
                  <span class="text-ink-muted"> · {modo}</span>
                </span>
              </header>

              <div
                class="flex min-h-0 flex-1 flex-col justify-end gap-3 overflow-hidden px-4 pb-1 pt-4 sm:gap-3.5 sm:px-6"
              >
                <p class="text-center text-[12px] text-ink-faint">Viernes, 14 de agosto</p>

                {mensajes.map(({ de, autor, nota, texto, viejo }) => (
                  <div
                    class:list={[
                      'flex',
                      viejo && 'film-viejo',
                      de === 'cliente' ? 'justify-start' : 'justify-end',
                    ]}
                  >
                    <div
                      class:list={[
                        'flex max-w-[86%] items-end gap-2 sm:max-w-[76%]',
                        de !== 'cliente' && 'flex-row-reverse',
                      ]}
                    >
                      {de === 'cliente' ? (
                        <Foto size={30} />
                      ) : (
                        <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-violet/30 bg-violet-soft text-[10.5px] font-semibold text-violet">
                          {autor.charAt(0)}
                        </span>
                      )}
                      <div>
                        <p
                          class:list={[
                            'rounded-2xl border px-3.5 py-2 text-[13px] leading-relaxed text-ink-primary sm:text-[14px]',
                            de === 'cliente'
                              ? 'rounded-bl-md border-tint/[0.07] bg-tint/[0.055]'
                              : 'rounded-br-md border-violet/25 bg-violet-soft',
                          ]}
                        >
                          {texto}
                        </p>
                        {autor && (
                          <p class="mt-1 flex items-center justify-end gap-1 text-[11.5px] text-ink-faint">
                            <IconBolt size={11} />
                            {autor}
                            {nota && <span class="text-violet">· {nota}</span>}
                          </p>
                        )}
                      </div>
                    </div>
                  </div>
                ))}

                {/* El mensaje que manda la persona. Crece en su lugar al
                    enviarse, en vez de aparecer encima. */}
                {respuesta && (
                  <div class="film-crece">
                    <div class="film-out flex justify-end">
                      <div class="flex max-w-[86%] flex-row-reverse items-end gap-2 sm:max-w-[76%]">
                        <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-tint/15 bg-tint/10 text-[10.5px] font-semibold text-ink-primary">
                          A
                        </span>
                        <div>
                          <p
                            class="rounded-2xl rounded-br-md border border-violet/25 bg-violet-soft px-3.5 py-2 text-[13px] leading-relaxed text-ink-primary sm:text-[14px]"
                          >
                            {respuesta}
                          </p>
                          <p class="mt-1 flex items-center justify-end gap-1 text-[11.5px] text-ink-faint">
                            <IconBolt size={11} />
                            Admin
                          </p>
                        </div>
                      </div>
                    </div>
                  </div>
                )}
              </div>
            </div>
          ))
        }
      </div>

      <div class="mx-auto w-full max-w-[40rem] shrink-0 px-4 pb-4 pt-1.5 sm:px-5 sm:pb-5">
        <div class="film-sug-caja">
          <div class="film-sug mb-2 overflow-hidden rounded-2xl border border-violet/25 bg-violet-soft">
            <div class="flex items-start gap-2.5 px-3.5 pt-3">
              <span
                class="mt-px flex h-6 w-6 shrink-0 items-center justify-center rounded-lg bg-violet/15 text-violet"
              >
                <IconSparkles size={13} />
              </span>
              <div class="min-w-0 flex-1">
                <p class="text-[12px] font-medium text-violet">
                  Respuesta sugerida
                  <span class="text-ink-muted"> · la escribió Ventas</span>
                </p>
                <p class="film-sug-texto mt-1 text-[13px] leading-snug text-ink-primary sm:text-[13.5px]">
                  {RESPUESTAS.martin}
                </p>
              </div>
            </div>
            <div class="mt-2.5 flex items-center justify-end gap-1 border-t border-violet/15 px-2.5 py-1.5">
              <span class="rounded-lg px-2.5 py-1 text-[12px] text-ink-muted">Descartar</span>
              <span
                class="rounded-lg bg-violet px-2.5 py-1 text-[12px] font-medium text-ink-inverted"
                data-t="usar"
              >
                Usar y editar
              </span>
            </div>
          </div>
        </div>

        <div
          class="flex items-end gap-1 rounded-3xl border border-tint/[0.09] bg-surface-raised p-1.5 shadow-card"
        >
          {/* El texto que se tipea y el marcador de posición son hermanos: el
              CSS esconde el segundo en cuanto el primero deja de estar vacío,
              sin que el guión tenga que acordarse de apagarlo. */}
          {/* El cuadro crece con el texto hasta un techo y después se queda
              quieto mostrando el final, como el de la app: en una columna
              angosta esta respuesta son seis renglones y sin tope el composer
              se comía el hilo entero. */}
          <span
            class="film-cuadro relative flex min-w-0 max-h-20 flex-1 flex-col justify-end overflow-hidden px-2.5 py-2 text-[13.5px] leading-relaxed sm:text-[14px]"
          >
            <span class="film-campo text-ink-primary"></span><span class="film-ph text-ink-faint"
              >Escribe un mensaje</span
            >
          </span>
          <span class="flex shrink-0 items-center gap-0.5 pr-0.5 text-ink-muted">
            <span class="flex h-8 w-8 items-center justify-center"><IconSmile size={17} /></span>
            <span class="flex h-8 w-8 items-center justify-center"><IconPaperclip size={17} /></span>
            <span class="flex h-8 w-8 items-center justify-center"><IconMic size={17} /></span>
            <span
              class="flex h-8 w-8 items-center justify-center rounded-full bg-ink-primary text-ink-inverted"
              data-t="enviar"
            >
              <IconSend size={15} />
            </span>
          </span>
        </div>
      </div>
    </section>
  </div>

  <span class="film-cursor">
    <span class="film-cursor-onda"></span>
    <span class="film-cursor-punta">
      <svg width="26" height="26" viewBox="0 0 24 24" aria-hidden="true">
        <path
          fill="#fff"
          stroke="#18181b"
          stroke-width="1.15"
          stroke-linejoin="round"
          d="M4.6 2.8v17.2l4.4-4.4 3.4 7.5 2.7-1.2-3.4-7.4 6.6.1Z"
        ></path>
      </svg>
    </span>
  </span>
</div>

<style>
  .film {
    user-select: none;
  }

  .film * {
    pointer-events: none;
  }

  /* Cursor
     ------------------------------------------------------------------------
     El translate lo escribe el guión en píxeles medidos; acá solo vive cómo
     viaja. La punta de la flecha está en (5, 3) del SVG: ese es el punto que
     tiene que caer sobre el botón, y por eso el clic y la onda se anclan ahí
     en vez de al centro de la caja. */
  .film-cursor {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 20;
    width: 26px;
    height: 26px;
    opacity: 0;
    transform: translate3d(0, 0, 0);
    transition:
      transform 760ms var(--ease-out-soft),
      opacity 300ms linear;
  }

  [data-cursor='si'] .film-cursor {
    opacity: 1;
  }

  .film-cursor-punta {
    display: block;
    transform-origin: 5px 3px;
    filter: drop-shadow(0 1px 2px rgb(24 24 27 / 0.28));
  }

  .film-cursor-punta svg {
    display: block;
  }

  .film-cursor.is-clic .film-cursor-punta {
    animation: film-apreta 360ms var(--ease-out-soft);
  }

  .film-cursor-onda {
    position: absolute;
    left: 5px;
    top: 3px;
    margin: -13px 0 0 -13px;
    width: 26px;
    height: 26px;
    border: 2px solid rgb(var(--violet));
    border-radius: 999px;
    opacity: 0;
  }

  .film-cursor.is-clic .film-cursor-onda {
    animation: film-onda 480ms var(--ease-out-soft);
  }

  @keyframes film-apreta {
    0%,
    100% {
      transform: scale(1);
    }
    45% {
      transform: scale(0.78);
    }
  }

  @keyframes film-onda {
    0% {
      opacity: 0.7;
      transform: scale(0.3);
    }
    100% {
      opacity: 0;
      transform: scale(1.6);
    }
  }

  /* Estados
     ------------------------------------------------------------------------ */
  .film-hilo {
    opacity: 0;
    transition: opacity 300ms var(--ease-out-soft);
  }

  [data-escena='martin'] .film-hilo-martin,
  [data-escena='laura'] .film-hilo-laura,
  [data-escena='nicolas'] .film-hilo-nicolas {
    opacity: 1;
  }

  .film-fila {
    transition: background-color 240ms linear;
  }

  [data-escena='martin'] .film-fila-martin,
  [data-escena='laura'] .film-fila-laura,
  [data-escena='nicolas'] .film-fila-nicolas {
    background: rgb(var(--violet-soft));
  }

  /* `data-enviado` es una lista de claves ("martin laura"): cada chat se
     marca al mandarse y no se borra al pasar al siguiente. */
  .film-despues {
    display: none;
  }

  [data-enviado~='martin'] .film-fila-martin .film-antes,
  [data-enviado~='laura'] .film-fila-laura .film-antes {
    display: none;
  }

  [data-enviado~='martin'] .film-fila-martin .film-despues,
  [data-enviado~='laura'] .film-fila-laura .film-despues {
    display: flex;
  }

  /* Lo que aparece empujando: la burbuja enviada y la tarjeta de la sugerencia
     al irse. `grid-template-rows` de 1fr a 0fr mide el contenido solo — con un
     max-height a ojo, la mitad de la transición no se ve moverse. */
  .film-crece,
  .film-sug-caja {
    display: grid;
    transition: grid-template-rows 320ms var(--ease-out-soft);
  }

  .film-crece {
    grid-template-rows: 0fr;
  }

  [data-enviado~='martin'] .film-hilo-martin .film-crece,
  [data-enviado~='laura'] .film-hilo-laura .film-crece {
    grid-template-rows: 1fr;
  }

  .film-sug-caja {
    grid-template-rows: 1fr;
  }

  [data-sugerencia='no'] .film-sug-caja,
  [data-escena='nicolas'] .film-sug-caja {
    grid-template-rows: 0fr;
  }

  .film-out,
  .film-sug {
    min-height: 0;
    overflow: hidden;
    transition: opacity 240ms linear;
  }

  .film-out {
    opacity: 0;
  }

  [data-enviado~='martin'] .film-hilo-martin .film-out,
  [data-enviado~='laura'] .film-hilo-laura .film-out {
    opacity: 1;
  }

  [data-sugerencia='no'] .film-sug,
  [data-escena='nicolas'] .film-sug {
    opacity: 0;
  }

  /* El marcador de posición es el que le da alto al cuadro cuando no hay nada
     escrito, así que se va del flujo en vez de apagarse: si se quedara puesto
     e invisible, el renglón vacío mediría dos líneas. */
  .film-campo:not(:empty) + .film-ph {
    display: none;
  }

  .film-campo:not(:empty)::after {
    content: '';
    display: inline-block;
    margin-left: 1.5px;
    width: 1.5px;
    height: 1.05em;
    vertical-align: -0.18em;
    background: rgb(var(--violet));
    animation: film-caret 1.1s steps(1) infinite;
  }

  @keyframes film-caret {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }

  @media (max-width: 1023px) {
    .film-viejo {
      display: none;
    }
  }

  /* Quien pidió menos movimiento ve el cuadro que cuenta la sección —el
     borrador esperando— quieto. El guión ni arranca. */
  @media (prefers-reduced-motion: reduce) {
    .film-cursor {
      display: none;
    }
  }
</style>

<script>
  // El guión mueve el cursor y cambia de estado; el CSS de arriba se encarga de
  // cómo se ve cada estado. Nada de esto es interactivo: es una película.
  const film = document.querySelector('[data-film]')
  const cursor = film?.querySelector('.film-cursor')
  const campo = film?.querySelector('.film-campo')
  const quieto = window.matchMedia('(prefers-reduced-motion: reduce)')

  if (film && cursor && campo) {
    const sugTexto = film.querySelector('.film-sug-texto')
    const dormir = (ms) => new Promise((listo) => setTimeout(listo, ms))

    // Cada vuelta del loop lleva su número. Al salir de pantalla se incrementa
    // y la vuelta en curso se corta en su próxima espera, en lugar de seguir
    // corriendo escondida o pisarse con la que arranca al volver.
    let vuelta = 0
    let enPantalla = false
    let ultimo = null

    function textoDe(clave) {
      return film.querySelector(`.film-hilo-${clave}`)?.dataset.respuesta || ''
    }

    function ponerSugerencia(clave) {
      if (sugTexto) sugTexto.textContent = textoDe(clave)
    }

    function marcarEnviado(clave) {
      const ya = (film.dataset.enviado || '').split(' ').filter(Boolean)
      if (!ya.includes(clave)) ya.push(clave)
      film.dataset.enviado = ya.join(' ')
    }

    function mover(el, dur, fx, fy) {
      const caja = film.getBoundingClientRect()
      const t = el.getBoundingClientRect()
      const x = t.left - caja.left + t.width * fx - 5
      const y = t.top - caja.top + t.height * fy - 3
      cursor.style.transitionDuration = `${dur}ms`
      cursor.style.transform = `translate3d(${x}px, ${y}px, 0)`
      ultimo = { el, fx, fy }
    }

    function clic() {
      cursor.classList.remove('is-clic')
      // Fuerza el reflow: sin esto el navegador no vuelve a correr la misma
      // animación cuando se le saca y se le pone la clase en el mismo cuadro.
      void cursor.offsetWidth
      cursor.classList.add('is-clic')
    }

    // Devuelve false si el objetivo no está en pantalla: abajo de lg no hay
    // lista de chats, y ahí el paso se saltea en vez de apuntar a la nada.
    async function clicEn(nombre, mia, dur = 780, fx = 0.5, fy = 0.5) {
      const el = film.querySelector(`[data-t="${nombre}"]`)
      if (!el || !el.offsetParent) return false
      mover(el, dur, fx, fy)
      await dormir(dur)
      if (mia !== vuelta) return false
      clic()
      await dormir(200)
      return mia === vuelta
    }

    async function tipear(texto, mia) {
      for (let i = 1; i <= texto.length; i += 2) {
        campo.textContent = texto.slice(0, i)
        await dormir(14)
        if (mia !== vuelta) return
      }
      campo.textContent = texto
    }

    async function abrirChat(clave, mia) {
      const abrio = await clicEn(`fila-${clave}`, mia, 780, 0.42)
      if (mia !== vuelta) return
      if (!abrio) await dormir(400)
      if (mia !== vuelta) return
      film.dataset.escena = clave
    }

    // Usar el borrador, tipear y mandar. El chat ya tiene que estar abierto.
    async function contestar(clave, mia) {
      ponerSugerencia(clave)
      film.dataset.sugerencia = 'si'
      await dormir(420)
      if (mia !== vuelta) return
      await clicEn('usar', mia, 780)
      if (mia !== vuelta) return
      film.dataset.sugerencia = 'no'
      await dormir(280)
      if (mia !== vuelta) return
      await tipear(textoDe(clave), mia)
      if (mia !== vuelta) return
      await dormir(480)
      if (mia !== vuelta) return
      await clicEn('enviar', mia, 600)
      if (mia !== vuelta) return
      marcarEnviado(clave)
      campo.textContent = ''
    }

    function reposo() {
      film.dataset.escena = 'martin'
      film.dataset.sugerencia = 'si'
      film.dataset.enviado = ''
      film.dataset.cursor = 'no'
      campo.textContent = ''
      ponerSugerencia('martin')
      const caja = film.getBoundingClientRect()
      cursor.style.transitionDuration = '0ms'
      cursor.style.transform = `translate3d(${caja.width * 0.62}px, ${caja.height * 0.46}px, 0)`
      ultimo = null
    }

    async function correr(mia) {
      while (mia === vuelta) {
        reposo()
        await dormir(800)
        if (mia !== vuelta) return

        film.dataset.cursor = 'si'
        await dormir(420)
        if (mia !== vuelta) return

        // 1. Martín: plata, borrador. Una persona lo manda.
        await contestar('martin', mia)
        if (mia !== vuelta) return
        await dormir(1100)
        if (mia !== vuelta) return

        // 2. Laura: también plata, también espera. El cursor sigue.
        await abrirChat('laura', mia)
        if (mia !== vuelta) return
        await contestar('laura', mia)
        if (mia !== vuelta) return
        await dormir(1100)
        if (mia !== vuelta) return

        // 3. Nicolás: el agente ya lo contestó solo. Solo se mira.
        await abrirChat('nicolas', mia)
        if (mia !== vuelta) return
        await dormir(2200)
        if (mia !== vuelta) return

        film.dataset.cursor = 'no'
        await dormir(600)
      }
    }

    function arrancar() {
      if (!enPantalla || document.hidden || quieto.matches) return
      vuelta += 1
      correr(vuelta)
    }

    function parar() {
      vuelta += 1
      reposo()
    }

    reposo()

    if ('IntersectionObserver' in window) {
      const ver = new IntersectionObserver(
        ([entrada]) => {
          enPantalla = entrada.isIntersecting
          if (enPantalla) arrancar()
          else parar()
        },
        { threshold: 0.35 },
      )
      ver.observe(film)
    } else {
      enPantalla = true
      arrancar()
    }

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) parar()
      else arrancar()
    })

    // El cursor apunta a un elemento medido, no a un porcentaje: si cambia el
    // ancho hay que volver a medir o queda señalando el lugar de antes.
    let remedir
    window.addEventListener('resize', () => {
      clearTimeout(remedir)
      remedir = setTimeout(() => {
        if (ultimo && ultimo.el.offsetParent) mover(ultimo.el, 0, ultimo.fx, ultimo.fy)
      }, 150)
    })

    quieto.addEventListener('change', () => {
      if (quieto.matches) parar()
      else arrancar()
    })
  }
</script>
