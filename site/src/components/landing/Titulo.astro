---
// Encabezado de sección: etiqueta chica en violeta, título y bajada opcional.
const { etiqueta, titulo, texto } = Astro.props
---

<div class="max-w-2xl">
  <p class="text-[12px] font-semibold uppercase tracking-[0.12em] text-violet">{etiqueta}</p>
  <h2 class="mt-3 text-3xl font-medium leading-[1.12] tracking-tight text-ink-primary sm:text-4xl sm:leading-[1.1]">
    {titulo}
  </h2>
  {
    texto && (
      <p class="mt-4 text-[19px] font-normal leading-[28px] text-ink-secondary">{texto}</p>
    )
  }
</div>
