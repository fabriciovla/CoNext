---
import Reveal from '../Reveal.astro'

// Encabezado de sección: etiqueta chica en violeta, título y bajada opcional.
const { etiqueta, titulo, texto } = Astro.props
---

<Reveal class="max-w-2xl">
  <p class="text-[12px] font-semibold uppercase tracking-[0.12em] text-violet">{etiqueta}</p>
  <h2 class="mt-3 text-3xl font-semibold leading-[1.15] tracking-tight text-ink-primary sm:text-4xl">
    {titulo}
  </h2>
  {texto && <p class="mt-4 text-[16px] leading-relaxed text-ink-secondary">{texto}</p>}
</Reveal>
