---
import '../index.css'
import Navbar from '../components/Navbar.astro'
import Footer from '../components/Footer.astro'
import { EMAIL } from '../config'
import { getLocale, t, switchLocale } from '../i18n/utils'
import { normalizarRuta, origenDe, urlCanonico } from '../lib/seo'

const { title, description, pantallaCompleta = false, noindex = false } = Astro.props
const lang = getLocale(Astro)
const copy = t(lang)
const ruta = normalizarRuta(Astro.url.pathname)
const altEs = urlCanonico(switchLocale(ruta, 'es'), Astro.site)
const altEn = urlCanonico(switchLocale(ruta, 'en'), Astro.site)

// Host de `astro.config` + ruta sin query ni barra final. Si la canónica
// apunta a un host que redirige (el apex, o la misma URL con slash), Google
// la descarta y la página queda como duplicada sin versión elegida.
const canonica = urlCanonico(ruta, Astro.site)
const origen = origenDe(Astro.site)

// La imagen de la vista previa necesita URL absoluta: los scrapers de WhatsApp
// y compañía no resuelven rutas relativas. El 512 es cuadrado, por eso la
// tarjeta de Twitter va como `summary` y no `summary_large_image` — ese formato
// espera 1200×630 y con un cuadrado recorta la marca.
const imagenOg = new URL('/icon-512.png', `${origen}/`)

const esquemaSitio = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${origen}/#org`,
      name: 'Conext',
      alternateName: ['conext', 'Conext CRM'],
      url: `${origen}/`,
      logo: imagenOg.href,
      email: EMAIL,
      description:
        'CRM para pequeñas empresas que unifica WhatsApp, Instagram y Messenger en una sola bandeja. Los agentes de IA responden lo seguro o dejan el borrador.',
      knowsAbout: ['CRM', 'WhatsApp Business', 'Instagram', 'Messenger', 'small business'],
      contactPoint: {
        '@type': 'ContactPoint',
        email: EMAIL,
        contactType: 'customer support',
        availableLanguage: ['Spanish', 'English'],
      },
    },
    {
      '@type': 'SoftwareApplication',
      '@id': `${origen}/#aplicacion`,
      name: 'Conext',
      alternateName: ['conext', 'Conext CRM'],
      applicationCategory: 'BusinessApplication',
      applicationSubCategory: 'CRM',
      operatingSystem: 'Web',
      url: `${origen}/`,
      publisher: { '@id': `${origen}/#org` },
    },
    {
      '@type': 'WebSite',
      '@id': `${origen}/#website`,
      url: `${origen}/`,
      name: 'Conext',
      alternateName: 'conext',
      inLanguage: ['es', 'en'],
      publisher: { '@id': `${origen}/#org` },
    },
  ],
}
---

<!doctype html>
<html lang={copy.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- El PNG va primero: Chrome no pinta un SVG con máscara en la pestaña,
         deja el ícono en blanco y pone la inicial del <title> (la C de
         conext). Pasa justo al volver del checkout de Dodo, que recarga el
         favicon. El SVG sigue detrás, ya sin máscara, para quien sí lo dibuja.
         El apple-touch-icon va aparte: iOS compone la transparencia sobre negro. -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="icon" type="image/svg+xml" href="/conext-mark.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- El manifiesto existe solo para que Android encuentre los íconos de 192 y
         512 que vinieron con el diseño; va con `display: browser` porque esto es
         una landing y no una app para instalar. -->
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Satoshi la usa todo el texto de la página, así que se pide de entrada
         en vez de esperar a que el CSS la descubra. `crossorigin` no es
         opcional aunque sea del mismo origen: sin él el navegador descarga el
         archivo dos veces. -->
    <link rel="preload" href="/fonts/satoshi-var.woff2" as="font" type="font/woff2" crossorigin />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonica} />
    <link rel="alternate" hreflang="es" href={altEs} />
    <link rel="alternate" hreflang="en" href={altEn} />
    <link rel="alternate" hreflang="x-default" href={altEs} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <!-- El color con el que Chrome en Android pinta la barra del sistema. -->
    <meta name="theme-color" content="#ffffff" />

    <!-- Vista previa al compartir el enlace (WhatsApp, X, LinkedIn). Ahora cada
         página trae la suya, que era imposible con una sola SPA: había un juego
         de etiquetas para las cuatro rutas. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Conext" />
    <meta property="og:locale" content={copy.ogLocale} />
    {lang === 'es' ? (
      <meta property="og:locale:alternate" content="en_US" />
    ) : (
      <meta property="og:locale:alternate" content="es_LA" />
    )}
    <meta property="og:url" content={canonica} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imagenOg} />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:image:alt" content={copy.ogImageAlt} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imagenOg} />
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(esquemaSitio)} />}
    <slot name="head" />
  </head>

  <body>
    {pantallaCompleta ? (
      <main>
        <slot />
      </main>
    ) : (
      <Fragment>
        {/* El fondo (el porqué está en index.css): la luz de apertura, anclada
            al tope del documento y por detrás de la barra, y el centinela —40px
            al ras de arriba— que le avisa a la barra cuándo dejar de ser
            transparente. El contenido va encima con z-10. */}
        <div class="fondo-alba" aria-hidden="true"></div>
        <div id="tope-pagina" class="pointer-events-none absolute inset-x-0 top-0 h-10" aria-hidden="true"></div>
        <div class="relative z-10 flex min-h-full flex-col">
          {/* Ninguno de los dos lleva directiva `client:`: todo el sitio llega como
              HTML. Lo poco que es interactivo (el menú de la barra, el acordeón de
              preguntas) lo resuelven scripts sueltos de unas pocas líneas, y el
              navegador no descarga React en ninguna página. */}
          <Navbar lang={lang} />
          <main class="flex flex-1 flex-col">
            <slot />
          </main>
          <Footer lang={lang} />
        </div>
      </Fragment>
    )}

    <script>
      // La barra: transparente arriba de todo, franja opaca en cuanto la página
      // se corrió. Se resuelve mirando un centinela de 40px pegado al tope del
      // documento en vez de escuchar `scroll`: el observer avisa dos veces en
      // toda la visita y el listener correría en cada cuadro.
      const tope = document.getElementById('tope-pagina')
      const barra = document.getElementById('barra')
      if (tope && barra && 'IntersectionObserver' in window) {
        const verTope = new IntersectionObserver((entradas) => {
          for (const entrada of entradas) barra.classList.toggle('barra-fija', !entrada.isIntersecting)
        })
        verTope.observe(tope)
      }

      // Los resplandores se pausan fuera de pantalla y con la pestaña oculta:
      // una animación infinita abajo de todo sigue compositando igual.
      const fondos = document.querySelectorAll('.fondo-seccion')
      if ('IntersectionObserver' in window && fondos.length) {
        const verFondos = new IntersectionObserver(
          (entradas) => {
            for (const entrada of entradas) {
              entrada.target.classList.toggle('fondo-vivo', entrada.isIntersecting)
            }
          },
          { rootMargin: '48px 0px' },
        )
        fondos.forEach((el) => verFondos.observe(el))
      }

      document.addEventListener('visibilitychange', () => {
        document.documentElement.classList.toggle('pagina-oculta', document.hidden)
      })
    </script>
  </body>
</html>
