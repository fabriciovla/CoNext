---
import '../index.css'
import Navbar from '../components/Navbar.astro'
import Footer from '../components/Footer.astro'
import { getLocale, t, switchLocale } from '../i18n/utils'

const { title, description, pantallaCompleta = false, noindex = false } = Astro.props
const lang = getLocale(Astro)
const copy = t(lang)
const pathname = Astro.url.pathname
const altEs = new URL(switchLocale(pathname, 'es'), Astro.site)
const altEn = new URL(switchLocale(pathname, 'en'), Astro.site)

// La URL canónica sale del dominio de astro.config más la ruta de la página.
// Astro.site ya está definido ahí; sin canónica, el mismo HTML servido con y
// sin barra final (o detrás de otro dominio) cuenta como contenido duplicado.
const canonica = new URL(Astro.url.pathname, Astro.site)

// La imagen de la vista previa necesita URL absoluta: los scrapers de WhatsApp
// y compañía no resuelven rutas relativas. El 512 es cuadrado, por eso la
// tarjeta de Twitter va como `summary` y no `summary_large_image` — ese formato
// espera 1200×630 y con un cuadrado recorta la marca.
const imagenOg = new URL('/icon-512.png', Astro.site)
---

<!doctype html>
<html lang={copy.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- El SVG primero: un favicon se dibuja a 16 px y a ese tamaño un raster se
         ve mordido. El PNG de 32 es el respaldo para lo que no acepta favicon
         vectorial.
         El logotipo toma `currentColor`, pero el favicon no puede: lo dibuja
         el navegador en su barra de pestañas, fuera de nuestro documento. Por
         eso `conext-mark.svg` resuelve el tema con `prefers-color-scheme`
         adentro del archivo — y sigue al tema del navegador, no al del sitio,
         porque la barra de pestañas es oscura aunque la página sea clara.
         El PNG no puede cambiar de color, así que va en la variante clara.
         El apple-touch-icon va aparte y con fondo blanco propio, porque iOS
         compone la transparencia sobre negro. -->
    <link rel="icon" type="image/svg+xml" href="/conext-mark.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- El manifiesto existe solo para que Android encuentre los íconos de 192 y
         512 que vinieron con el diseño; va con `display: browser` porque esto es
         una landing y no una app para instalar. -->
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Satoshi la usa todo el texto de la página, así que se pide de entrada
         en vez de esperar a que el CSS la descubra. `crossorigin` no es
         opcional aunque sea del mismo origen: sin él el navegador descarga el
         archivo dos veces. -->
    <link rel="preload" href="/fonts/satoshi-var.woff2" as="font" type="font/woff2" crossorigin />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonica} />
    <link rel="alternate" hreflang="es" href={altEs} />
    <link rel="alternate" hreflang="en" href={altEn} />
    <link rel="alternate" hreflang="x-default" href={altEs} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <!-- El color con el que Chrome en Android pinta la barra del sistema. -->
    <meta name="theme-color" content="#ffffff" />

    <!-- Vista previa al compartir el enlace (WhatsApp, X, LinkedIn). Ahora cada
         página trae la suya, que era imposible con una sola SPA: había un juego
         de etiquetas para las cuatro rutas. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="conext" />
    <meta property="og:locale" content={copy.ogLocale} />
    {lang === 'es' ? (
      <meta property="og:locale:alternate" content="en_US" />
    ) : (
      <meta property="og:locale:alternate" content="es_LA" />
    )}
    <meta property="og:url" content={canonica} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imagenOg} />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:image:alt" content={copy.ogImageAlt} />
    <meta name="twitter:card" content="summary" />
    <slot name="head" />
  </head>

  <body>
    {pantallaCompleta ? (
      <main>
        <slot />
      </main>
    ) : (
      <Fragment>
        {/* Cuadrícula fija detrás de la página. El contenido va encima con z-10. */}
        <div class="fondo" aria-hidden="true">
          <div class="fondo-cuadricula"></div>
        </div>
        <div class="relative z-10 flex min-h-full flex-col">
          {/* Ninguno de los dos lleva directiva `client:`: todo el sitio llega como
              HTML. Lo poco que es interactivo (el menú de la barra, el acordeón de
              preguntas) lo resuelven scripts sueltos de unas pocas líneas, y el
              navegador no descarga React en ninguna página. */}
          <Navbar lang={lang} />
          <main class="flex flex-1 flex-col">
            <slot />
          </main>
          <Footer lang={lang} />
        </div>
      </Fragment>
    )}

    <script>
      // Los resplandores se pausan fuera de pantalla y con la pestaña oculta:
      // una animación infinita abajo de todo sigue compositando igual.
      const fondos = document.querySelectorAll('.fondo-seccion')
      if ('IntersectionObserver' in window && fondos.length) {
        const verFondos = new IntersectionObserver(
          (entradas) => {
            for (const entrada of entradas) {
              entrada.target.classList.toggle('fondo-vivo', entrada.isIntersecting)
            }
          },
          { rootMargin: '48px 0px' },
        )
        fondos.forEach((el) => verFondos.observe(el))
      }

      document.addEventListener('visibilitychange', () => {
        document.documentElement.classList.toggle('pagina-oculta', document.hidden)
      })
    </script>
  </body>
</html>
