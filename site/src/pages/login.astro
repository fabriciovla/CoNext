---
import Base from '../layouts/Base.astro'
import Boton from '../components/Boton.jsx'
import Logo from '../components/Logo.jsx'
import { IconBolt, IconSparkles, IconShield } from '../components/icons.jsx'
import { APP_URL, WHATSAPP_URL } from '../config'

// La barra apunta acá, no directo al CRM: en local el CRM vive en otro puerto
// y un <a href="http://localhost:5173"> o no abre (el preview lo bloquea) o
// cae en un servidor que no está levantado. Esta página sí es de este sitio.
// El form, si está completo, manda a APP_URL — esa es la llamada al CRM.
//
// La página se queda con el alto entero (sin barra ni pie): es la puerta de
// entrada a la app, no una sección más del sitio. El logo del panel izquierdo
// es lo que vuelve al inicio.
//
// Las entradas usan `.animate-in`, no `.reveal`: esto no scrollea, y el
// observer del layout con margen negativo dejaría el pie invisible.
const CAMPO =
  'w-full rounded-xl border border-tint/[0.12] bg-transparent px-3.5 py-2.5 text-[14px] text-ink-primary placeholder:text-ink-faint transition-colors duration-150 focus:border-violet/60 focus:outline-none focus:ring-1 focus:ring-violet/30'

const PESTANA =
  'h-9 rounded-lg text-[13px] font-medium transition-colors duration-200 aria-selected:bg-surface-card aria-selected:text-ink-primary aria-selected:shadow-card text-ink-muted hover:text-ink-primary'

const VENTAJAS = [
  { Icono: IconBolt, texto: 'Respuesta al instante' },
  { Icono: IconSparkles, texto: 'Borradores con IA' },
  { Icono: IconShield, texto: 'Datos por cliente' },
]
---

<Base
  title="Entrar · conext"
  description="Entrá a tu cuenta de conext para atender el WhatsApp de tu negocio."
  pantallaCompleta
  noindex
>
  <div class="min-h-dvh bg-surface-page lg:grid lg:grid-cols-2">
    {/* El panel de marca no se muestra abajo de lg: en una pantalla angosta,
        apilarlo arriba del formulario deja el campo de correo bajo el pliegue. */}
    <section
      class="relative hidden overflow-hidden border-r border-tint/[0.07] bg-surface-card px-10 py-10 lg:flex lg:flex-col"
    >
      {/* Dos resplandores de marca, arriba y abajo. Son el único fondo del
          panel: el resto es la superficie limpia. */}
      <div
        class="animate-in-fade pointer-events-none absolute -left-28 -top-32 h-[440px] w-[440px] rounded-full opacity-[0.12] blur-[130px]"
        style="background: linear-gradient(135deg, #9085e9 0%, #d55181 100%); --d: 80ms"
        aria-hidden="true"
      >
      </div>
      <div
        class="animate-in-fade pointer-events-none absolute -bottom-36 -right-24 h-[400px] w-[400px] rounded-full opacity-[0.09] blur-[130px]"
        style="background: linear-gradient(135deg, #9085e9 0%, #d55181 100%); --d: 200ms"
        aria-hidden="true"
      >
      </div>

      <div class="relative flex flex-1 flex-col items-center justify-center text-center">
        {/* El logotipo grande es el centro del panel, y de paso es la salida:
            desde acá no hay barra que lleve de vuelta al sitio. Comparte
            `view-transition-name` con el de la barra: al entrar, crece desde
            ahí. Al salir el script de abajo le saca el nombre, si no el
            morph inverso achica este isotipo sobre la landing. */}
        <a
          href="/"
          class="logo-vt-escritorio animate-in-scale text-ink-primary transition-opacity duration-200 hover:opacity-80 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-violet"
          style="--d: 60ms"
        >
          <Logo className="h-[68px] w-auto" />
        </a>

        <h1
          class="animate-in mt-12 max-w-[15ch] text-[36px] font-semibold leading-[1.12] tracking-tight text-ink-primary"
          style="--d: 160ms"
        >
          Todo WhatsApp.
          <br />
          <span class="text-violet">Una sola bandeja.</span>
        </h1>
        <p class="animate-in mt-4 max-w-[42ch] text-[14px] leading-relaxed text-ink-muted" style="--d: 220ms">
          La IA clasifica cada mensaje, contesta lo seguro y te deja el resto redactado para revisar.
        </p>
      </div>

      <ul
        class="animate-in-fade relative flex items-center justify-center gap-6 text-[12px] text-ink-faint"
        style="--d: 320ms"
      >
        {VENTAJAS.map(({ Icono, texto }) => (
          <li class="flex items-center gap-1.5">
            <Icono size={13} />
            {texto}
          </li>
        ))}
      </ul>
    </section>

    <section class="flex min-h-dvh items-center justify-center px-5 py-12 lg:min-h-0">
      <div class="w-full max-w-[360px]">
        {/* El logotipo vuelve acá solo cuando el panel de marca no está. */}
        <a
          href="/"
          class="logo-vt-movil animate-in-down mb-8 flex justify-center text-ink-primary transition-opacity duration-200 hover:opacity-80 lg:hidden"
        >
          <Logo className="h-6 w-auto" />
        </a>

        <div
          id="pestanas"
          role="tablist"
          aria-label="Acceso"
          class="animate-in grid grid-cols-2 gap-1 rounded-xl border border-tint/[0.08] bg-tint/[0.03] p-1"
          style="--d: 80ms"
        >
          <button
            type="button"
            role="tab"
            id="tab-ingresar"
            aria-controls="panel-ingresar"
            aria-selected="true"
            tabindex="0"
            class={PESTANA}
          >
            Iniciar sesión
          </button>
          <button
            type="button"
            role="tab"
            id="tab-crear"
            aria-controls="panel-crear"
            aria-selected="false"
            tabindex="-1"
            class={PESTANA}
          >
            Crear cuenta
          </button>
        </div>

        <div
          id="panel-ingresar"
          role="tabpanel"
          aria-labelledby="tab-ingresar"
          class="animate-in mt-8"
          style="--d: 160ms"
        >
          <h2 class="text-center text-[27px] font-semibold tracking-tight text-ink-primary">
            Hola de nuevo
          </h2>
          <p class="mb-6 mt-1.5 text-center text-[13.5px] text-ink-muted">
            Entrá para atender el WhatsApp de tu negocio.
          </p>

          {/* Los campos van adentro de una tarjeta y no sueltos sobre la página:
              el campo es transparente, así que sin superficie propia el borde de
              1px es lo único que lo separa del fondo. */}
          <form
            id="form-login"
            novalidate
            class="space-y-4 rounded-2xl border border-tint/10 bg-surface-card p-5 shadow-card"
            data-app={APP_URL}
          >
            <label for="email" class="block">
              <span class="mb-1.5 block text-[12.5px] text-ink-secondary">Correo</span>
              <input
                id="email"
                name="email"
                type="email"
                autocomplete="username"
                required
                placeholder="tu@negocio.com"
                class={CAMPO}
              />
            </label>
            <label for="password" class="block">
              <span class="mb-1.5 block text-[12.5px] text-ink-secondary">Contraseña</span>
              <input
                id="password"
                name="password"
                type="password"
                autocomplete="current-password"
                required
                placeholder="••••••••"
                class={CAMPO}
              />
            </label>
            <p id="login-error" hidden class="animate-in-pop text-[13px] text-status-critical"></p>
            <Boton as="button" className="w-full">Entrar</Boton>
          </form>
        </div>

        <div id="panel-crear" role="tabpanel" aria-labelledby="tab-crear" hidden class="mt-8">
          <h2 class="text-center text-[27px] font-semibold tracking-tight text-ink-primary">
            Pedí tu acceso
          </h2>
          <p class="mb-6 mt-1.5 text-center text-[13.5px] leading-relaxed text-ink-muted">
            Damos de alta cada negocio a mano: escribinos y te dejamos el número conectado con tu cuenta
            lista para entrar.
          </p>
          <Boton href={WHATSAPP_URL} className="w-full">Pedir una demo</Boton>
        </div>
      </div>
    </section>
  </div>
</Base>

<script>
  // El morph del logo es de ida nomas: barra → panel. `pageswap` corre en
  // esta página, justo antes del snapshot de salida, y le saca el nombre
  // compartido. Sin eso el isotipo grande viaja de vuelta y se achica
  // encima de una landing que ya está dibujada.
  const soltarLogo = () => {
    document.querySelectorAll('.logo-vt-escritorio, .logo-vt-movil').forEach((el) => {
      el.style.viewTransitionName = 'none'
    })
  }
  window.addEventListener('pageswap', (e) => {
    if (e.viewTransition) soltarLogo()
  })

  const pestanas = document.getElementById('pestanas')
  const tabs = [...(pestanas?.querySelectorAll('[role="tab"]') ?? [])]
  const paneles = {
    'tab-ingresar': document.getElementById('panel-ingresar'),
    'tab-crear': document.getElementById('panel-crear'),
  }

  const entrar = (el, clase = 'animate-in') => {
    if (!el) return
    el.classList.remove(clase)
    // El retraso del `--d` es del escalonado de la primera carga. Si se queda,
    // cada cambio de pestaña arranca con el panel invisible ese rato, porque la
    // animación llena hacia atrás (`backwards`) y parece que no pasó nada.
    el.style.setProperty('--d', '0ms')
    // Forzar recálculo para que volver a poner la clase reinicie la animación:
    // sin esto, cambiar de pestaña no anima la segunda vez.
    void el.offsetWidth
    el.classList.add(clase)
  }

  // Lo elegido se lee del `aria-selected` en vez de una clase aparte: ya hay que
  // mantenerlo para que un lector de pantalla se entere, y así no hay dos
  // fuentes de verdad que se puedan desincronizar (los estilos de la pestaña
  // activa cuelgan de ese mismo atributo).
  const elegir = (tab, enfocar = false) => {
    for (const otra of tabs) {
      const elegida = otra === tab
      otra.setAttribute('aria-selected', String(elegida))
      // Tabindex rotativo: al grupo se entra con Tab en la pestaña activa y de
      // ahí se pasa con las flechas. Sin esto hay que tabular por todas las
      // pestañas antes de llegar al formulario, que es lo que se quiere usar.
      otra.tabIndex = elegida ? 0 : -1
      const panel = paneles[otra.id]
      if (panel) panel.hidden = !elegida
      if (elegida) entrar(panel)
    }
    if (enfocar) tab.focus()
  }

  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => elegir(tab))
    tab.addEventListener('keydown', (evento) => {
      const salto = { ArrowRight: 1, ArrowLeft: -1 }[evento.key]
      const destino =
        salto !== undefined
          ? tabs[(i + salto + tabs.length) % tabs.length]
          : evento.key === 'Home'
            ? tabs[0]
            : evento.key === 'End'
              ? tabs[tabs.length - 1]
              : null
      if (!destino) return
      // Las flechas dentro de un tablist mueven entre pestañas, no scrollean.
      evento.preventDefault()
      elegir(destino, true)
    })
  })

  const form = document.getElementById('form-login')
  const error = document.getElementById('login-error')

  const mostrarError = (texto) => {
    if (!error) return
    error.hidden = false
    error.textContent = texto
    entrar(error, 'animate-in-pop')
  }

  // El aviso se borra apenas se escribe: si no, se queda contradiciendo lo que
  // la persona ya corrigió y hay que mandar de nuevo para verlo desaparecer.
  form?.addEventListener('input', () => {
    if (error) error.hidden = true
  })

  form?.addEventListener('submit', (evento) => {
    evento.preventDefault()
    const datos = new FormData(form)
    const correo = String(datos.get('email') ?? '').trim()
    const clave = String(datos.get('password') ?? '')

    // El form va con `novalidate`: los `required` frenaban el envío antes de
    // llegar acá y el globito del navegador tapaba este aviso, que nunca se
    // llegaba a ver. Los atributos se quedan porque los lee el lector de
    // pantalla; validar es cosa nuestra.
    if (!correo || !clave) {
      mostrarError('Escribí tu correo y tu contraseña.')
      return
    }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(correo)) {
      mostrarError('Ese correo no parece válido.')
      return
    }

    const destino = form.dataset.app
    if (!destino) return
    // La dashboard también pide sesión, así que le pasamos quién entró y no
    // vuelve a preguntar: sin esto, entrar por acá te deja frente a un segundo
    // formulario idéntico. Va el nombre del correo, no el correo entero, que es
    // lo que la barra de la app muestra al lado del avatar. Es tan de mentira
    // como el resto de este login: nada de esto autoriza una request.
    const usuario = correo.split('@')[0]
    window.location.assign(`${destino}/?u=${encodeURIComponent(usuario)}`)
  })
</script>
