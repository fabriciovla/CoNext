---
import Base from '../layouts/Base.astro'
import Cuestionario from '../components/empezar/Cuestionario.jsx'
import { APP_URL, API_URL, ALTA_CLAVE, EMAIL, dodoCheckout } from '../config'
import { getLocale, t } from '../i18n/utils'

const lang = getLocale(Astro)
const copy = t(lang).empezar

// **La query no se lee acá.** Esta página es estática: el frontmatter corre una
// sola vez, en el build, y el HTML que se sirve es el mismo para toda URL. Un
// `Astro.url.searchParams.get('plan')` queda horneado —se puede ver en
// `dist/empezar/index.html`, con `"plan":[0,"gratis"]` adentro de las props— y
// en producción ignora lo que venga en la dirección. Así estuvo `?plan=` desde
// que existe la vuelta de Dodo: toda alta se guardaba como "gratis" sin importar
// qué habían comprado. En desarrollo parecía andar porque Astro prerrenderiza y
// cachea la página, y la primera visita fija el valor para las siguientes.
//
// Los tres parámetros —plan, correo, sinplan— los lee el navegador: el script de
// abajo y `Cuestionario`, que corre con `client:load`.

// Los precios salen de la misma fuente que /precios, y los destinos se calculan
// acá: resolverlos al hacer clic obligaría a bajar el catálogo al navegador.
// Van solo los mensuales. Elegir entre mensual y anual es una decisión más
// arriba de esta pantalla, y quien está acá viene de contestar cuatro preguntas
// para poder entrar; el interruptor de periodicidad vive en /precios, que es
// donde se compara de verdad.
const planes = t(lang).precios.planes.map((p) => ({
  id: p.id,
  nombre: p.nombre,
  bajada: p.bajada,
  precio: p.precio,
  periodo: p.periodo,
  cta: p.cta,
  destacado: Boolean(p.destacado),
  href: p.destino === 'email' ? `mailto:${EMAIL}` : dodoCheckout(p.id, 'mensual'),
}))
---

<Base title={copy.title} description={copy.description} pantallaCompleta noindex>
  {/* El atajo del navegador solo manda cuando no vino ni correo ni sinplan. Con
      correo el que decide es el server —la dashboard ya preguntó por el plan
      antes de mandar acá—, y hacerle caso al flag local dejaría afuera del
      cuestionario a alguien que entra con otra cuenta en la misma máquina. Y
      mandar a la app a quien no tiene plan es devolverlo al corte del que acaba
      de venir.

      Va inline y antes de pintar, como el script del tema: decidido desde React,
      la pantalla aparece y se va.

      **El plan viaja con él.** Quien ya contestó y vuelve del checkout entra
      derecho, pero la dashboard tiene que saber que atrás hay un pago recién
      hecho: sin eso pregunta una sola vez por el plan, el webhook de Dodo
      todavía no llegó y lo devuelve acá con la tabla de precios adelante tres
      segundos después de haber pagado. Con `?plan=` puesto, espera. */}
  <script
    is:inline
    set:html={`
      try {
        var q = new URLSearchParams(location.search);
        var propio = !q.get('correo') && q.get('sinplan') !== '1';
        var d = propio ? JSON.parse(localStorage.getItem(${JSON.stringify(ALTA_CLAVE)}) || 'null') : null;
        if (d && d.listo) {
          var url = new URL(${JSON.stringify(APP_URL)}, location.origin);
          var plan = q.get('plan') || d.plan || '';
          if (plan) url.searchParams.set('plan', plan);
          if (d.correo) url.searchParams.set('u', String(d.correo).split('@')[0]);
          location.replace(url.toString());
        } else document.documentElement.classList.add('empezar-vivo');
      } catch (e) {
        document.documentElement.classList.add('empezar-vivo');
      }
    `}
  />

  <div class="empezar-pagina">
    <div class="orbe -left-40 -top-36 h-[28rem] w-[28rem]" style="--d: 80ms" aria-hidden="true"></div>
    <div class="orbe -bottom-40 -right-36 h-[24rem] w-[24rem]" style="--d: 200ms" aria-hidden="true"></div>
    <Cuestionario client:load copy={copy} planes={planes} appUrl={APP_URL} apiUrl={API_URL} />
  </div>
</Base>
