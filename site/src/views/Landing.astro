---
import Base from '../layouts/Base.astro'
import Titulo from '../components/landing/Titulo.astro'
import Boton from '../components/Boton.jsx'
import AppMock from '../components/landing/AppMock.jsx'
import Mascota from '../components/landing/Mascota.jsx'
import ControlFilm from '../components/landing/ControlFilm.astro'
import LineaAhorro from '../components/landing/LineaAhorro.astro'
import Faq from '../components/landing/Faq.astro'
import { LogoMarca } from '../components/Logo.jsx'
import { IconArrowRight, IconCheck, IconShield, IconTag } from '../components/icons.jsx'
import { dodoCheckout } from '../config'
import { getLocale, t, pathFor } from '../i18n/utils'
import { origenDe, urlCanonico } from '../lib/seo.js'

const lang = getLocale(Astro)
const l = t(lang).landing
const ayudaHref = pathFor(lang, '/ayuda')

const ICONOS_GARANTIA = [IconShield, IconTag, IconCheck]
const GARANTIAS = l.garantias.map((item, i) => ({ ...item, Icono: ICONOS_GARANTIA[i] }))

const CONTENEDOR = 'contenedor'
const CONTENEDOR_MUESTRA = 'contenedor'

// Organization y WebSite ya los pone Base (#org, #website). Acá solo se
// suma lo de esta página: el CRM como SoftwareApplication y el FAQPage
// con "¿Qué es Conext?", que es la definición de marca que el H1 solo
// no alcanza a sostener.
const origen = origenDe(Astro.site)
const pagina = urlCanonico(Astro.url.pathname, Astro.site).href
const idioma = lang === 'en' ? 'en' : 'es'
const ESQUEMA = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      '@id': `${origen}/#aplicacion`,
      name: 'Conext',
      alternateName: ['conext', 'Conext CRM'],
      applicationCategory: 'BusinessApplication',
      applicationSubCategory: 'CRM',
      operatingSystem: 'Web',
      description: l.description,
      url: pagina,
      inLanguage: idioma,
      featureList: l.funciones.map((f) => f.titulo),
      audience: {
        '@type': 'BusinessAudience',
        audienceType: lang === 'en' ? 'Small businesses' : 'Pequeñas empresas',
      },
      creator: { '@id': `${origen}/#org` },
      publisher: { '@id': `${origen}/#org` },
    },
    {
      '@type': 'FAQPage',
      '@id': `${origen}/#preguntas`,
      mainEntity: l.preguntas.map(({ pregunta, respuesta }) => ({
        '@type': 'Question',
        name: pregunta,
        acceptedAnswer: { '@type': 'Answer', text: respuesta },
      })),
    },
  ],
}
---

<Base title={l.title} description={l.description}>
  <script type="application/ld+json" set:html={JSON.stringify(ESQUEMA)} />
  {/* ---------------------------------------------------------------------- */}
  {/* Hero                                                                    */}
  {/* ---------------------------------------------------------------------- */}
  {/* Dos columnas a partir de `xl`: el texto a la izquierda y la app a la
      derecha, a la altura del titular. Antes el hero era una sola columna con
      la muestra abajo de todo, y eso dejaba el primer pantallazo entero en
      manos de una promesa escrita — la app aparecía recién scrolleando, que es
      justo lo que hay que ver primero.

      La izquierda es una medida fija (30rem) y no una fracción: es una columna
      de texto, así que lo que tiene que quedar clavado es el largo del renglón,
      y lo que sobra se lo lleva la muestra, que siempre agradece el ancho.

      Abajo de `xl` vuelven a apilarse y la muestra ocupa la hoja entera, que a
      ese ancho es la única forma de que la bandeja se lea. */}
  <section class="fondo-seccion pb-16 pt-14 sm:pt-20 xl:pb-24">
    <div class={CONTENEDOR}>
      <div class="grid items-center gap-16 xl:grid-cols-[30rem_minmax(0,1fr)] xl:gap-12">
        <div>
          {/* Dos líneas, y el corte va siempre y no solo en pantalla ancha: son
              dos mitades de la misma frase —los canales, y dónde caen— y
              partidas por el ancho de la ventana el corte cae en cualquier
              lado. El titular tiene que entenderse solo; si nombra un canal, el
              que atiende por otro se baja. */}
          <h1
            class="animate-in text-[34px] font-semibold leading-[1.08] tracking-[-0.02em] text-ink-primary sm:text-[46px] lg:text-[54px] xl:text-[48px]"
          >
            {l.heroLineas[0]}<br />{l.heroLineas[1]}
          </h1>

          <p
            class="animate-in mt-6 max-w-xl text-[18px] font-normal leading-[28px] text-ink-secondary"
            style="--d: 80ms"
          >
            {l.heroBajada}
          </p>

          <div class="animate-in mt-8 flex flex-wrap items-center gap-3" style="--d: 160ms">
            <Boton href={pathFor(lang, '/postulate')} tamano="lg" target="_self">
              {l.heroCta}
              <IconArrowRight size={17} />
            </Boton>
            <Boton href="#como-funciona" variante="secundario" tamano="lg">{l.verComo}</Boton>
          </div>

          {/* Los tres agentes, con la cara que la app les dibuja de verdad.
              Reemplazan a la fila de marcas que iba abajo de los botones ("API
              oficial de Meta", "sin apps no oficiales"): eso era la letra chica
              de la promesa y vive entera en Garantías, y acá abajo del titular
              lo que falta contestar no es con qué está hecho el CRM sino quién
              atiende del otro lado. */}
          <ul class="mt-12 space-y-7 sm:space-y-8">
            {
              l.heroAgentes.map(({ cara, nombre, texto }, i) => (
                <li class="animate-in flex items-center gap-5" style={`--d: ${240 + i * 90}ms`}>
                  <Mascota cara={cara} size={104} className="hidden sm:block" />
                  <Mascota cara={cara} size={76} className="sm:hidden" />
                  <div class="min-w-0">
                    <h2 class="text-[17px] font-medium text-ink-primary">{nombre}</h2>
                    <p class="mt-1 text-[15px] leading-relaxed text-ink-secondary">{texto}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>

        {/* La muestra. Los fantasmas que la rodean van sueltos y solo en
            pantalla ancha: apilada, la muestra ocupa la hoja de borde a borde y
            no queda margen donde apoyarlos sin taparle una columna. */}
        <div class="animate-in-scale relative" style="--d: 200ms">
          <Mascota cara="sola" size={148} className="absolute -left-12 -top-16 z-10 hidden -rotate-6 xl:block" />
          <div class="marco-producto relative contain-paint overflow-hidden rounded-2xl">
            <div class="flex items-center gap-1.5 border-b border-tint/[0.07] px-4 py-2.5">
              <span class="h-2.5 w-2.5 rounded-full bg-tint/25"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-tint/25"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-tint/25"></span>
            </div>
            <AppMock lang={lang} hero alto="h-[460px] sm:h-[540px] xl:h-[560px]" />
          </div>
          <Mascota cara="idea" size={92} className="absolute -bottom-10 right-24 z-10 hidden rotate-3 xl:block" />
          <Mascota cara="sola" size={116} className="absolute -bottom-14 -right-10 z-10 hidden -rotate-3 xl:block" />
        </div>
      </div>
    </div>
  </section>

  {/* ---------------------------------------------------------------------- */}
  {/* Lo que se ahorra                                                        */}
  {/* ---------------------------------------------------------------------- */}
  {/* Reemplaza a la grilla de funciones ("Qué es Conext"): esas seis
      capacidades ya tienen su propia página por `/producto/*` y siguen
      alimentando el featureList del schema.org de más arriba. Acá lo que
      importa no es qué hace el CRM sino qué cambia al usarlo — la misma
      pregunta del cliente resuelta a mano contra resuelta por Conext. El id
      "funciones" se mantiene porque el pie de página todavía linkea `/#funciones`
      desde la columna Recursos. */}
  <section id="funciones" class="scroll-mt-24 py-24 sm:py-32">
    <div class={CONTENEDOR}>
      <p class="text-[12px] font-semibold uppercase tracking-[0.12em] text-violet">{l.ahorroEtiqueta}</p>
      <div class="mt-6 border-t border-tint/10 pt-16 sm:pt-20">
        <LineaAhorro items={l.ahorros} resumen={l.ahorroResumen} />
      </div>
    </div>
  </section>

  {/* ---------------------------------------------------------------------- */}
  {/* El control                                                              */}
  {/* ---------------------------------------------------------------------- */}
  <section id="control" class="fondo-seccion scroll-mt-24 pt-20 sm:pt-28">
    <div class={CONTENEDOR}>
      <p class="text-[12px] font-semibold uppercase tracking-[0.12em] text-violet">{l.controlEtiqueta}</p>
      <div class="mt-6 border-t border-tint/10"></div>
    </div>
    <div class={`${CONTENEDOR_MUESTRA} mt-14 sm:mt-16`}>
      <div class="relative contain-paint overflow-hidden rounded-2xl border border-tint/10 bg-surface-nav shadow-pop">
        <div class="flex items-center gap-1.5 border-b border-tint/[0.07] px-4 py-2.5">
          <span class="h-2.5 w-2.5 rounded-full bg-tint/25"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-tint/25"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-tint/25"></span>
        </div>
        <ControlFilm lang={lang} />
      </div>
    </div>
  </section>

  {/* ---------------------------------------------------------------------- */}
  {/* Cómo funciona                                                           */}
  {/* ---------------------------------------------------------------------- */}
  <section id="como-funciona" class="scroll-mt-24 py-24 sm:py-32">
    <div class={CONTENEDOR}>
      <Titulo etiqueta={l.pasosEtiqueta} titulo={l.pasosTitulo} />

      <ol class="mt-14 grid gap-10 sm:grid-cols-3 sm:gap-8">
        {
          l.pasos.map(({ titulo, texto }, i) => (
            <li>
              <span class="flex h-10 w-10 items-center justify-center rounded-full border border-tint/10 bg-tint/[0.04] text-[15px] font-semibold tabular-nums text-violet">
                {i + 1}
              </span>
              <h3 class="mt-5 text-[18px] font-medium text-ink-primary">{titulo}</h3>
              <p class="mt-2.5 text-[19px] font-normal leading-[28px] text-ink-secondary">{texto}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* ---------------------------------------------------------------------- */}
  {/* Garantías                                                               */}
  {/* ---------------------------------------------------------------------- */}
  <section id="garantias" class="fondo-seccion scroll-mt-24 py-24 sm:py-32">
    <div class={CONTENEDOR}>
      <Titulo etiqueta={l.garantiasEtiqueta} titulo={l.garantiasTitulo} texto={l.garantiasTexto} />

      <div class="mt-14 grid gap-8 sm:grid-cols-3">
        {
          GARANTIAS.map(({ Icono, titulo, texto }) => (
            <div class="rounded-2xl border border-tint/10 bg-surface-card p-6">
              <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-tint/[0.05] text-ink-primary">
                <Icono size={19} />
              </span>
              <h3 class="mt-5 text-[16px] font-medium text-ink-primary">{titulo}</h3>
              <p class="mt-2.5 text-[15px] leading-relaxed text-ink-secondary">{texto}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ---------------------------------------------------------------------- */}
  {/* Preguntas                                                               */}
  {/* ---------------------------------------------------------------------- */}
  <section id="preguntas" class="scroll-mt-24 py-24 sm:py-32">
    <div class={`${CONTENEDOR} max-w-3xl`}>
      <Titulo etiqueta={l.faqEtiqueta} titulo={l.faqTitulo} />
      <div class="mt-12">
        <Faq preguntas={l.preguntas} />
      </div>
      <p class="mt-8 text-[15px] text-ink-muted">
        {l.faqMas}{' '}
        <a
          href={ayudaHref}
          class="text-ink-primary underline decoration-tint/25 underline-offset-2 transition-colors duration-200 hover:decoration-violet"
        >
          {l.faqCentro}
        </a>.
      </p>
    </div>
  </section>

  {/* ---------------------------------------------------------------------- */}
  {/* Última llamada                                                          */}
  {/* ---------------------------------------------------------------------- */}
  <section class="pb-24 pt-4 sm:pb-32">
    <div class={CONTENEDOR}>
      <div class="llamada rounded-3xl px-8 py-20 text-center sm:px-20 sm:py-24">
        <div class="llamada-arcos" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </div>
        <div>
          <LogoMarca className="mx-auto h-14 w-auto text-violet" />
          <h2
            class="mx-auto mt-6 max-w-2xl text-[28px] font-semibold leading-tight tracking-tight text-ink-primary sm:text-[34px]"
          >
            {l.ctaTitulo}
          </h2>
          <p class="mx-auto mt-4 max-w-md text-[16px] leading-relaxed text-ink-secondary sm:text-[17px]">
            {l.ctaTexto}
          </p>
          <div class="mt-8 flex flex-wrap justify-center">
            <Boton href={dodoCheckout('gratis')} tamano="lg" target="_self">
              {l.ctaBoton}
              <IconArrowRight size={17} />
            </Boton>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
