---
import Base from '../layouts/Base.astro'
import Titulo from '../components/landing/Titulo.astro'
import Boton from '../components/Boton.jsx'
import { LogoMarca } from '../components/Logo.jsx'
import AppMock from '../components/landing/AppMock.jsx'
import ControlFilm from '../components/landing/ControlFilm.astro'
import Orbita from '../components/landing/Orbita.astro'
import Faq from '../components/landing/Faq.astro'
import {
  IconArrowRight,
  IconBolt,
  IconBox,
  IconChart,
  IconCheck,
  IconChevronRight,
  IconClock,
  IconInbox,
  IconShield,
  IconSparkles,
  IconTag,
  IconWhatsApp,
} from '../components/icons.jsx'
import { WHATSAPP_URL } from '../config'
import { getLocale, t, pathFor } from '../i18n/utils'
import { LANDING_A_PRODUCTO } from '../data/producto'

const lang = getLocale(Astro)
const l = t(lang).landing
const ayudaHref = pathFor(lang, '/ayuda')

const ICONOS = {
  bandeja: IconInbox,
  agentes: IconSparkles,
  automatico: IconBolt,
  productos: IconBox,
  horarios: IconClock,
  dia: IconChart,
}

const FUNCIONES = Object.fromEntries(
  l.funciones.map((f) => [f.id, { ...f, Icono: ICONOS[f.id] }]),
)

const GRUPOS_FUNCIONES = l.grupos.map((grupo) => ({
  ...grupo,
  funciones: grupo.ids.map((id) => FUNCIONES[id]),
}))

const ICONOS_GARANTIA = [IconShield, IconTag, IconCheck]
const GARANTIAS = l.garantias.map((item, i) => ({ ...item, Icono: ICONOS_GARANTIA[i] }))

const CONTENEDOR = 'contenedor'
const CONTENEDOR_MUESTRA = 'contenedor'

const ESQUEMA = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'conext',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description: l.description,
  url: Astro.site?.href,
  inLanguage: lang === 'en' ? 'en' : 'es',
}
---

<Base title={l.title} description={l.description}>
  <script type="application/ld+json" set:html={JSON.stringify(ESQUEMA)} />
  {/* ---------------------------------------------------------------------- */}
  {/* Hero                                                                    */}
  {/* ---------------------------------------------------------------------- */}
  <section class="fondo-seccion pt-14 sm:pt-20">
    <div class={CONTENEDOR}>
      <a
        href="#garantias"
        class="animate-in-fade group inline-flex items-center gap-2 text-[15px] text-violet transition-colors duration-200 hover:text-ink-primary"
      >
        <IconWhatsApp size={15} className="text-status-good" />
        {l.anuncio}
        <IconChevronRight size={14} className="transition-transform duration-200 group-hover:translate-x-0.5" />
      </a>

      <h1
        class="animate-in mt-7 max-w-5xl text-balance text-[32px] font-medium leading-[1.12] tracking-tight text-ink-primary sm:text-[44px] lg:text-[56px] lg:leading-[1.08] lg:text-wrap"
        style="--d: 80ms"
      >
        {l.heroLineas[0]}
        <br class="hidden lg:inline" /> {l.heroLineas[1]}
        <br class="hidden lg:inline" /> {l.heroLineas[2]}
      </h1>

      <p
        class="animate-in mt-7 max-w-2xl text-[19px] font-normal leading-[28px] text-ink-secondary"
        style="--d: 160ms"
      >
        <span class="font-medium text-ink-primary">conext</span> {l.heroBajada}
      </p>

      <div class="animate-in mt-10 flex flex-wrap items-center gap-3" style="--d: 240ms">
        <Boton href={WHATSAPP_URL} tamano="lg">
          {l.pedirDemo}
          <IconArrowRight size={17} />
        </Boton>
        <Boton href="#como-funciona" variante="secundario" tamano="lg">{l.verComo}</Boton>
      </div>

      <p class="animate-in-fade mt-7 text-[18px] leading-relaxed text-ink-muted" style="--d: 320ms">
        {l.pieHero}
      </p>
    </div>

    <div class={`${CONTENEDOR_MUESTRA} mt-16 sm:mt-20`}>
      <div class="relative">
        <div class="marco-producto relative contain-paint overflow-hidden rounded-t-2xl">
          <div class="flex items-center gap-1.5 border-b border-tint/[0.07] px-4 py-2.5">
            <span class="h-2.5 w-2.5 rounded-full bg-tint/25"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-tint/25"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-tint/25"></span>
          </div>
          <AppMock lang={lang} />
        </div>
        <div
          aria-hidden="true"
          class="pointer-events-none absolute inset-x-0 bottom-0 h-28 bg-gradient-to-b from-transparent to-surface-page"
        >
        </div>
      </div>
    </div>
  </section>

  {/* ---------------------------------------------------------------------- */}
  {/* Funciones                                                               */}
  {/* ---------------------------------------------------------------------- */}
  <section id="funciones" class="scroll-mt-24 py-24 sm:py-32">
    <div class={CONTENEDOR}>
      <Titulo etiqueta={l.funcionesEtiqueta} titulo={l.funcionesTitulo} texto={l.funcionesTexto} />

      <div class="mt-14">
        <Orbita funciones={FUNCIONES} lang={lang} />
      </div>

      <div class="mt-16 border-y border-tint/10">
        {
          GRUPOS_FUNCIONES.map(({ nombre, bajada, funciones }, grupo) => (
            <div
              class:list={[
                'grid grid-cols-1 lg:grid-cols-[0.72fr_1fr_1fr]',
                grupo > 0 && 'border-t border-tint/10',
              ]}
            >
              <div class="py-7 sm:py-8 lg:pr-10">
                <span class="text-[12px] font-semibold text-violet">0{grupo + 1}</span>
                <h3 class="mt-3 text-[18px] font-medium text-ink-primary">{nombre}</h3>
                <p class="mt-1.5 text-[19px] font-normal leading-[28px] text-ink-secondary">{bajada}</p>
              </div>

              {funciones.map(({ id, Icono, titulo, texto }, funcion) => {
                const destino = LANDING_A_PRODUCTO[id]
                const href = destino ? pathFor(lang, `/producto/${destino}`) : undefined
                const Tag = href ? 'a' : 'div'
                return (
                <Tag
                  id={id}
                  {...(href ? { href } : {})}
                  class:list={[
                    'group min-w-0 scroll-mt-24 border-t border-tint/10 py-7 sm:py-8 lg:border-l lg:border-t-0 lg:px-8',
                    funcion === 1 && 'lg:pr-0',
                    href && 'transition-colors duration-200 hover:bg-tint/[0.03]',
                  ]}
                >
                  <div class="flex items-center gap-3">
                    <Icono
                      size={20}
                      className="shrink-0 text-violet transition-colors duration-200 group-hover:text-ink-primary"
                    />
                    <h3 class="text-[18px] font-medium text-ink-primary">{titulo}</h3>
                  </div>
                  <p class="mt-3 max-w-md text-[15px] leading-relaxed text-ink-secondary">{texto}</p>
                </Tag>
                )
              })}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ---------------------------------------------------------------------- */}
  {/* El control                                                              */}
  {/* ---------------------------------------------------------------------- */}
  <section class="fondo-seccion scroll-mt-24 pt-20 sm:pt-28">
    <div class={CONTENEDOR}>
      <Titulo etiqueta={l.controlEtiqueta} titulo={l.controlTitulo} texto={l.controlTexto} />
    </div>

    <div class={`${CONTENEDOR_MUESTRA} mt-14 sm:mt-16`}>
      <div class="relative contain-paint overflow-hidden rounded-2xl border border-tint/10 bg-surface-nav shadow-pop">
        <div class="flex items-center gap-1.5 border-b border-tint/[0.07] px-4 py-2.5">
          <span class="h-2.5 w-2.5 rounded-full bg-tint/25"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-tint/25"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-tint/25"></span>
        </div>
        <ControlFilm lang={lang} />
      </div>
    </div>
  </section>

  {/* ---------------------------------------------------------------------- */}
  {/* Cómo funciona                                                           */}
  {/* ---------------------------------------------------------------------- */}
  <section id="como-funciona" class="scroll-mt-24 py-24 sm:py-32">
    <div class={CONTENEDOR}>
      <Titulo etiqueta={l.pasosEtiqueta} titulo={l.pasosTitulo} />

      <ol class="mt-14 grid gap-10 sm:grid-cols-3 sm:gap-8">
        {
          l.pasos.map(({ titulo, texto }, i) => (
            <li>
              <span class="flex h-10 w-10 items-center justify-center rounded-full border border-tint/10 bg-tint/[0.04] text-[15px] font-semibold tabular-nums text-violet">
                {i + 1}
              </span>
              <h3 class="mt-5 text-[18px] font-medium text-ink-primary">{titulo}</h3>
              <p class="mt-2.5 text-[19px] font-normal leading-[28px] text-ink-secondary">{texto}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* ---------------------------------------------------------------------- */}
  {/* Garantías                                                               */}
  {/* ---------------------------------------------------------------------- */}
  <section id="garantias" class="fondo-seccion scroll-mt-24 py-24 sm:py-32">
    <div class={CONTENEDOR}>
      <Titulo etiqueta={l.garantiasEtiqueta} titulo={l.garantiasTitulo} texto={l.garantiasTexto} />

      <div class="mt-14 grid gap-8 sm:grid-cols-3">
        {
          GARANTIAS.map(({ Icono, titulo, texto }) => (
            <div class="rounded-2xl border border-tint/10 bg-surface-card p-6">
              <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-tint/[0.05] text-ink-primary">
                <Icono size={19} />
              </span>
              <h3 class="mt-5 text-[16px] font-medium text-ink-primary">{titulo}</h3>
              <p class="mt-2.5 text-[15px] leading-relaxed text-ink-secondary">{texto}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ---------------------------------------------------------------------- */}
  {/* Preguntas                                                               */}
  {/* ---------------------------------------------------------------------- */}
  <section id="preguntas" class="scroll-mt-24 py-24 sm:py-32">
    <div class={`${CONTENEDOR} max-w-3xl`}>
      <Titulo etiqueta={l.faqEtiqueta} titulo={l.faqTitulo} />
      <div class="mt-12">
        <Faq preguntas={l.preguntas} />
      </div>
      <p class="mt-8 text-[15px] text-ink-muted">
        {l.faqMas}{' '}
        <a
          href={ayudaHref}
          class="text-ink-primary underline decoration-tint/25 underline-offset-2 transition-colors duration-200 hover:decoration-violet"
        >
          {l.faqCentro}
        </a>.
      </p>
    </div>
  </section>

  {/* ---------------------------------------------------------------------- */}
  {/* Última llamada                                                          */}
  {/* ---------------------------------------------------------------------- */}
  <section class="pb-24 pt-4 sm:pb-32">
    <div class={CONTENEDOR}>
      <div class="llamada rounded-3xl px-8 py-20 text-center sm:px-20 sm:py-24">
        <div class="llamada-arcos" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </div>
        <div>
          <LogoMarca className="mx-auto h-14 w-auto text-violet" />
          <h2
            class="mx-auto mt-6 max-w-2xl text-[28px] font-semibold leading-tight tracking-tight text-ink-primary sm:text-[34px]"
          >
            {l.ctaTitulo}
          </h2>
          <p class="mx-auto mt-4 max-w-md text-[16px] leading-relaxed text-ink-secondary sm:text-[17px]">
            {l.ctaTexto}
          </p>
          <div class="mt-8 flex flex-wrap justify-center">
            <Boton href={WHATSAPP_URL} tamano="lg">
              <IconWhatsApp size={17} />
              {l.ctaBoton}
            </Boton>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
