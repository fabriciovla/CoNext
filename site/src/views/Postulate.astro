---
import Base from '../layouts/Base.astro'
import Postulate from '../components/landing/Postulate.jsx'
import { API_URL } from '../config'
import { getLocale, t } from '../i18n/utils'

const lang = getLocale(Astro)
const p = t(lang).postulate

// Los mismos fantasmas que usa la dashboard para los contactos sin foto
// (ConextLogoContactos/avatars), sueltos alrededor de la tarjeta y no adentro:
// son la mascota, no el contenido, así que van de fondo, chicos y apagados.
const FANTASMAS = [
  { src: '/mascota-postulate-e.svg', clase: '-left-6 top-6 h-14 w-14 -rotate-12 sm:-left-12 sm:top-10 sm:h-20 sm:w-20' },
  { src: '/mascota-postulate-b.svg', clase: '-right-4 top-24 h-11 w-11 rotate-6 sm:-right-10 sm:top-32 sm:h-16 sm:w-16' },
  { src: '/mascota-postulate-f.svg', clase: 'bottom-8 -left-8 h-12 w-12 rotate-6 sm:bottom-14 sm:-left-16 sm:h-[4.5rem] sm:w-[4.5rem]' },
  { src: '/mascota-postulate-i.svg', clase: '-right-6 bottom-16 h-16 w-16 -rotate-6 sm:-right-14 sm:bottom-20 sm:h-24 sm:w-24' },
]
---

<Base title={p.title} description={p.description}>
  <section class="contenedor py-16 sm:py-24">
    <div class="relative mx-auto max-w-2xl">
      <div class="pointer-events-none absolute inset-0 hidden sm:block" aria-hidden="true">
        {
          FANTASMAS.map((f) => (
            <img src={f.src} alt="" class={`absolute opacity-70 ${f.clase}`} />
          ))
        }
      </div>

      <div class="relative rounded-3xl border border-tint/[0.1] bg-surface-card px-6 py-14 sm:px-16 sm:py-16">
        <Postulate client:load copy={p} apiUrl={API_URL} idioma={lang} />
      </div>
    </div>
  </section>
</Base>
