---
import Base from '../layouts/Base.astro'
import { LogoMarca } from '../components/Logo.jsx'
import Boton from '../components/Boton.jsx'
import Faq from '../components/landing/Faq.astro'
import {
  IconCheck,
  IconLayers,
  IconLayout,
  IconLightbulb,
  IconUsers,
} from '../components/icons.jsx'
import { dodoCheckout, WHATSAPP_URL } from '../config'
import { getLocale, t } from '../i18n/utils'
import { urlCanonico } from '../lib/seo'

const lang = getLocale(Astro)
const p = t(lang).precios

const ICONOS = {
  users: IconUsers,
  layout: IconLayout,
  layers: IconLayers,
  lightbulb: IconLightbulb,
}

// Empresa va siempre a WhatsApp, mensual o anual: no hay checkout que armar.
// Para el resto se calculan los dos destinos de una y se dejan puestos en el
// boton; el interruptor solo cambia cual de los dos esta en el href. Resolverlo
// al hacer clic obligaria a tener el catalogo en el navegador.
const destinosDe = (plan) =>
  plan.destino === 'whatsapp'
    ? { mensual: WHATSAPP_URL, anual: WHATSAPP_URL }
    : { mensual: dodoCheckout(plan.id, 'mensual'), anual: dodoCheckout(plan.id, 'anual') }

const ESQUEMA = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'conext',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description: p.description,
  url: urlCanonico(Astro.url.pathname, Astro.site).href,
  inLanguage: lang === 'en' ? 'en' : 'es',
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'USD',
    lowPrice: '39',
    highPrice: '149',
    offerCount: p.planes.length,
  },
}
---

<Base title={p.title} description={p.description}>
  <script type="application/ld+json" set:html={JSON.stringify(ESQUEMA)} />

  <article id="precios" class="contenedor pb-24 pt-14 sm:pb-32 sm:pt-20">
    <div>
      <p class="text-[12px] font-semibold uppercase tracking-[0.12em] text-violet">{p.etiqueta}</p>
      <h1
        class="mt-3 max-w-3xl text-balance text-[32px] font-medium leading-[1.12] tracking-tight text-ink-primary sm:text-[44px] lg:text-[52px] lg:leading-[1.08]"
      >
        {p.titulo}
      </h1>
      <p class="mt-4 max-w-xl text-[19px] font-normal leading-[28px] text-ink-secondary">
        {p.bajada}
      </p>

      {/* Mensual / anual. Son dos <button> y no un <input type="checkbox">
          disfrazado: no hay nada que enviar, y el estado que importa --cual de
          los dos manda-- se dice con aria-pressed, que es lo que un lector de
          pantalla anuncia. El precio y el destino de cada plan ya estan en el
          DOM (data-*): esto solo elige cual se muestra, asi que cambiar de
          periodo no pide red ni vuelve a pintar la tabla. */}
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <div class="periodo-switch" role="group" aria-label={p.periodicidad}>
          <button type="button" class="periodo-opcion is-activa" data-periodo="mensual" aria-pressed="true">
            {p.mensual}
          </button>
          <button type="button" class="periodo-opcion" data-periodo="anual" aria-pressed="false">
            {p.anual}
          </button>
        </div>
        <span class="text-[13px] font-medium text-violet">{p.ahorro}</span>
      </div>
    </div>

    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:hidden">
      {
        p.planes.map((plan) => (
          <div
            class:list={[
              'flex min-w-0 flex-col rounded-2xl border border-tint/10 bg-surface-card p-5',
              plan.destacado && 'border-violet/20 bg-violet/[0.055]',
            ]}
          >
            {
              plan.destacado && (
                <span class="plan-badge mb-3 w-fit">{p.masElegido}</span>
              )
            }
            <span class="mt-1 text-[20px] font-medium tracking-tight text-ink-primary">{plan.nombre}</span>
            <span class="mt-1 text-[14px] text-ink-muted">{plan.bajada}</span>
            <span class="mt-4">
              <span
                class="block text-[28px] font-semibold leading-none tracking-tight text-ink-primary"
                data-precio
                data-mensual={plan.precio}
                data-anual={plan.precioAnual}
              >
                {plan.precio}
              </span>
              <span
                class="mt-1.5 block text-[13px] text-ink-muted"
                data-periodo-texto
                data-mensual={plan.periodo}
                data-anual={plan.periodoAnual}
              >
                {plan.periodo}
              </span>
            </span>
            <Boton
              href={destinosDe(plan).mensual}
              data-destino
              data-mensual={destinosDe(plan).mensual}
              data-anual={destinosDe(plan).anual}
              variante={plan.destacado ? 'primario' : 'secundario'}
              className="mt-5 w-full"
              target={plan.destino === 'whatsapp' ? '_blank' : '_self'}
              rel={plan.destino === 'whatsapp' ? 'noreferrer' : undefined}
            >
              {plan.cta}
            </Boton>
          </div>
        ))
      }
    </div>

    <p class="mt-8 text-[13.5px] text-ink-muted lg:hidden">{p.desliza}</p>

    {/* Sigue a la barra al scrollear la tabla: la cabecera completa se iría
        y no se sabría qué columna es qué. Esta tira es chica a propósito —
        pegar la ficha entera (precio, período, botón) se comía medio viewport
        y, al achicarse, saltaba el scroll. Se enciende cuando la cabecera
        real ya pasó detrás de la barra, y se apaga al dejar la tabla. */}
    {/* Fuera de `.contenedor`: cada celda se posiciona con las coordenadas
        de su <th>, que ya están en el viewport. Si la tira también llevara
        el padding del contenedor, los precios quedarían corridos respecto
        de las columnas. */}
    <div id="precios-pegajosa" class="precios-pegajosa" aria-hidden="true">
      <div class="precios-pegajosa-grid">
        <div></div>
        {
          p.planes.map((plan) => (
            <div class:list={[plan.destacado && 'is-destacado']}>
              <span class="precios-pegajosa-nombre">{plan.nombre}</span>
              <span
                class="precios-pegajosa-precio"
                data-precio
                data-mensual={plan.precio}
                data-anual={plan.precioAnual}
              >
                {plan.precio}
              </span>
            </div>
          ))
        }
      </div>
    </div>

    <div class="tabla-precios-wrap mt-4 lg:mt-16">
      <table class="tabla-precios">
        <caption>{p.comparacion}</caption>
        <colgroup>
          <col class="col-funcion" />
          <col span="4" />
        </colgroup>
        <thead id="precios-cabecera">
          <tr>
            <th scope="col">
              <span class="sr-only">{p.funcion}</span>
              {/* Marca sola, centrada en el hueco de la primera columna.
                  Sin el nombre: al lado de los planes el "conext" escrito
                  competía con los títulos. Solo desde lg, que es donde
                  ese hueco existe. */}
              <div class="hidden justify-center lg:flex">
                <LogoMarca className="h-24 w-auto text-violet" />
              </div>
            </th>
            {
              p.planes.map((plan) => (
                <th scope="col">
                  {/* Abajo de lg la ficha del plan ya está arriba, en las
                      tarjetas: acá alcanza el nombre como rótulo de columna.
                      Con la ficha entera, el precio y el botón de cada plan
                      aparecían dos veces en la misma pantalla. */}
                  <span class="block text-[15px] font-medium text-ink-primary lg:hidden">
                    {plan.nombre}
                  </span>

                  <div class="hidden flex-col items-center lg:flex">
                    <div class="flex h-7 items-center">
                      {plan.destacado && <span class="plan-badge">{p.masElegido}</span>}
                    </div>
                    <span class="mt-1 block text-[22px] font-medium tracking-tight text-ink-primary">
                      {plan.nombre}
                    </span>
                    <span class="mt-1 block text-[14px] font-normal text-ink-muted">{plan.bajada}</span>
                    <span class="mt-5 block">
                      <span
                        class="block text-[32px] font-semibold leading-none tracking-tight text-ink-primary"
                        data-precio
                        data-mensual={plan.precio}
                        data-anual={plan.precioAnual}
                      >
                        {plan.precio}
                      </span>
                      <span
                        class="mt-2 block min-h-[2.5em] text-[13.5px] font-normal leading-snug text-ink-muted"
                        data-periodo-texto
                        data-mensual={plan.periodo}
                        data-anual={plan.periodoAnual}
                      >
                        {plan.periodo}
                      </span>
                    </span>
                    <Boton
                      href={destinosDe(plan).mensual}
                      data-destino
                      data-mensual={destinosDe(plan).mensual}
                      data-anual={destinosDe(plan).anual}
                      variante={plan.destacado ? 'primario' : 'secundario'}
                      className="mt-4 w-full"
                      target={plan.destino === 'whatsapp' ? '_blank' : '_self'}
                      rel={plan.destino === 'whatsapp' ? 'noreferrer' : undefined}
                    >
                      {plan.cta}
                    </Boton>
                  </div>
                </th>
              ))
            }
          </tr>
        </thead>
        {
          p.grupos.map((grupo) => {
            const Icono = ICONOS[grupo.icono]
            return (
              <tbody>
                <tr class="fila-grupo">
                  <th scope="colgroup">
                    <span class="flex items-center gap-2 text-[12px] font-semibold uppercase tracking-[0.12em] text-violet">
                      {Icono && <Icono size={16} className="shrink-0" />}
                      {grupo.nombre}
                    </span>
                  </th>
                  <td></td>
                  <td></td>
                  <td></td>
                  <td></td>
                </tr>
                {grupo.filas.map((fila) => (
                  <tr>
                    <th scope="row">{fila.nombre}</th>
                    {fila.valores.map((valor) => (
                      <td>
                        {valor === true ? (
                          <span class="inline-flex items-center justify-center text-violet">
                            <IconCheck size={18} />
                            <span class="sr-only">{p.incluido}</span>
                          </span>
                        ) : valor === false ? (
                          <span class="text-ink-faint">
                            —<span class="sr-only">{p.noIncluido}</span>
                          </span>
                        ) : (
                          valor
                        )}
                      </td>
                    ))}
                  </tr>
                ))}
              </tbody>
            )
          })
        }
      </table>
    </div>

    <script>
      // Cambiar de periodo es reemplazar texto que ya esta en el DOM: cada
      // monto trae su par en data-mensual/data-anual. Nada se recalcula ni se
      // pide al servidor, asi que el precio no parpadea al tocar el boton.
      const opciones = [...document.querySelectorAll('.periodo-opcion')]

      const aplicarPeriodo = (periodo) => {
        for (const el of document.querySelectorAll('[data-precio], [data-periodo-texto]')) {
          const valor = el.dataset[periodo]
          if (valor) el.textContent = valor
        }

        for (const el of document.querySelectorAll('[data-destino]')) {
          const destino = el.dataset[periodo]
          // Un plan sin producto anual todavia creado devuelve '#'. Se deja
          // inerte a proposito en vez de caer al mensual: mandar al checkout
          // de un precio distinto del que la pantalla acaba de mostrar es peor
          // que un boton que no hace nada.
          const inerte = !destino || destino === '#'
          el.setAttribute('href', destino || '#')
          // setAttribute y no toggleAttribute: aquel deja el atributo en cadena
          // vacía, que no es un valor ARIA válido y además no matchea el
          // [aria-disabled='true'] de la hoja, así que el botón se veía activo.
          if (inerte) el.setAttribute('aria-disabled', 'true')
          else el.removeAttribute('aria-disabled')
        }

        for (const boton of opciones) {
          const activa = boton.dataset.periodo === periodo
          boton.classList.toggle('is-activa', activa)
          boton.setAttribute('aria-pressed', activa ? 'true' : 'false')
        }
      }

      for (const boton of opciones) {
        boton.addEventListener('click', () => aplicarPeriodo(boton.dataset.periodo))
      }

      const barra = document.getElementById('precios-pegajosa')
      const cabecera = document.getElementById('precios-cabecera')
      const tabla = document.querySelector('.tabla-precios')
      const wrap = document.querySelector('.tabla-precios-wrap')
      const celdas = barra ? [...barra.querySelectorAll('.precios-pegajosa-grid > *')] : []
      const columnas = cabecera ? [...cabecera.querySelectorAll('th')] : []
      // 76px es el alto de `.barra`. Si la cabecera real todavía se ve debajo
      // de eso, la tira duplicaría los precios. Si la tabla ya se fue, la tira
      // flotaría sobre las preguntas.
      const ALTO_BARRA = 76

      const alinear = () => {
        columnas.forEach((th, i) => {
          const celda = celdas[i]
          if (!celda) return
          const r = th.getBoundingClientRect()
          celda.style.left = `${r.left}px`
          celda.style.width = `${r.width}px`
        })
      }

      const actualizar = () => {
        if (!barra || !cabecera || !tabla) return
        const head = cabecera.getBoundingClientRect()
        const cuerpo = tabla.getBoundingClientRect()
        const visible = head.bottom < ALTO_BARRA + 8 && cuerpo.bottom > ALTO_BARRA + 56
        barra.classList.toggle('is-visible', visible)
        barra.setAttribute('aria-hidden', visible ? 'false' : 'true')
        alinear()
      }

      actualizar()
      window.addEventListener('scroll', actualizar, { passive: true })
      window.addEventListener('resize', actualizar)
      wrap?.addEventListener('scroll', alinear, { passive: true })
    </script>

    <p class="mt-6 max-w-2xl text-[13.5px] leading-relaxed text-ink-muted">{p.nota}</p>

    <div class="mt-20 px-4 py-12 text-center sm:mt-24 sm:py-16">
      <h2 class="text-[24px] font-medium tracking-tight text-ink-primary sm:text-[28px]">
        {p.indecisoTitulo}
      </h2>
      <p class="mx-auto mt-3 max-w-md text-[16px] leading-relaxed text-ink-secondary">
        {p.indecisoTexto}
      </p>
      <div class="mt-8 flex justify-center">
        <Boton href={WHATSAPP_URL} tamano="lg">{p.indecisoCta}</Boton>
      </div>
    </div>

    <div class="mx-auto mt-20 max-w-3xl sm:mt-24">
      <h2 class="text-[24px] font-medium tracking-tight text-ink-primary sm:text-[28px]">
        {p.faqTitulo}
      </h2>
      <div class="mt-8">
        <Faq preguntas={p.preguntas} />
      </div>
    </div>
  </article>
</Base>
