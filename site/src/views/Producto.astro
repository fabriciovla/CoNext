---
import Base from '../layouts/Base.astro'
import Boton from '../components/Boton.jsx'
import {
  IconAlert,
  IconBox,
  IconBolt,
  IconChart,
  IconInbox,
  IconLayers,
  IconNote,
  IconShield,
  IconSparkles,
  IconTag,
  IconUsers,
  IconWhatsApp,
} from '../components/icons.jsx'
import { WHATSAPP_URL } from '../config'
import { paginaProducto, slugsDeColumna } from '../data/producto'
import { getLocale, t, pathFor } from '../i18n/utils'

const ICONOS = {
  inbox: IconInbox,
  tag: IconTag,
  note: IconNote,
  sparkles: IconSparkles,
  bolt: IconBolt,
  layers: IconLayers,
  box: IconBox,
  chart: IconChart,
  alert: IconAlert,
  whatsapp: IconWhatsApp,
  users: IconUsers,
  shield: IconShield,
}

const lang = getLocale(Astro)
const slug = Astro.params.slug
const meta = paginaProducto(slug)
const p = t(lang).producto
const pagina = p.paginas[slug]

const Icono = ICONOS[meta.icono]
const columnaNombre = p.columnas[meta.columna]
const hermanas = slugsDeColumna(meta.columna)
  .filter((s) => s !== slug)
  .map((s) => ({
    slug: s,
    href: pathFor(lang, `/producto/${s}`),
    nombre: p.paginas[s].nombre,
    Icono: ICONOS[paginaProducto(s).icono],
  }))

const ESQUEMA = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: pagina.title,
  description: pagina.description,
  url: Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined,
  inLanguage: lang === 'en' ? 'en' : 'es',
  isPartOf: {
    '@type': 'SoftwareApplication',
    name: 'conext',
    applicationCategory: 'BusinessApplication',
  },
}
---

<Base title={pagina.title} description={pagina.description}>
  <script type="application/ld+json" set:html={JSON.stringify(ESQUEMA)} />

  <article class="contenedor pb-24 pt-14 sm:pb-32 sm:pt-20">
    <div>
      <p class="text-[12px] font-semibold uppercase tracking-[0.12em] text-violet">{columnaNombre}</p>
      <div class="mt-4 flex items-start gap-4">
        {
          Icono && (
            <span class="mt-1 flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-violet/[0.08] text-violet">
              <Icono size={22} />
            </span>
          )
        }
        <div class="min-w-0">
          <h1 class="max-w-3xl text-balance text-[32px] font-medium leading-[1.12] tracking-tight text-ink-primary sm:text-[44px] lg:text-[52px] lg:leading-[1.08]">
            {pagina.titulo}
          </h1>
          <p class="mt-4 max-w-xl text-[19px] font-normal leading-[28px] text-ink-secondary">
            {pagina.bajada}
          </p>
        </div>
      </div>
    </div>

    <div class="mt-16 grid grid-cols-1 gap-14 lg:grid-cols-[minmax(0,1fr)_minmax(0,17rem)] lg:gap-20">
      <div class="min-w-0">
        {
          pagina.secciones.map((seccion) => (
            <section class="mt-14 first:mt-0">
              <h2 class="text-[24px] font-medium tracking-tight text-ink-primary sm:text-[28px]">
                {seccion.titulo}
              </h2>
              {seccion.parrafos.map((parrafo) => (
                <p class="mt-4 max-w-2xl text-[16px] leading-[1.7] text-ink-secondary">{parrafo}</p>
              ))}
            </section>
          ))
        }

        <section class="mt-16">
          <h2 class="text-[24px] font-medium tracking-tight text-ink-primary sm:text-[28px]">
            {p.enLaPractica}
          </h2>
          <ol class="mt-8 grid gap-8 sm:grid-cols-3 sm:gap-6">
            {
              pagina.pasos.map(({ titulo, texto }, i) => (
                <li>
                  <span class="flex h-10 w-10 items-center justify-center rounded-full border border-tint/10 bg-tint/[0.04] text-[15px] font-semibold tabular-nums text-violet">
                    {i + 1}
                  </span>
                  <h3 class="mt-4 text-[17px] font-medium text-ink-primary">{titulo}</h3>
                  <p class="mt-2 text-[15px] leading-relaxed text-ink-secondary">{texto}</p>
                </li>
              ))
            }
          </ol>
        </section>

        {
          pagina.cierre && (
            <p class="mt-16 max-w-2xl text-[16px] leading-[1.7] text-ink-secondary">{pagina.cierre}</p>
          )
        }
      </div>

      <aside class="self-start lg:sticky lg:top-24">
        <p class="text-[12px] font-medium text-ink-muted">{p.verTambien}</p>
        <ul class="mt-3 space-y-1">
          {
            hermanas.map(({ href, nombre, Icono: IconoHermana }) => (
              <li>
                <a
                  href={href}
                  class="flex items-center gap-2.5 rounded-lg px-3 py-2 text-[14px] font-medium text-ink-secondary transition-colors duration-200 hover:bg-tint/[0.04] hover:text-ink-primary"
                >
                  {IconoHermana && <IconoHermana size={16} className="shrink-0 text-violet" />}
                  <span class="whitespace-nowrap">{nombre}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </aside>
    </div>

    <div class="mt-20 px-4 py-12 text-center sm:mt-24 sm:py-16">
      <h2 class="text-[24px] font-medium tracking-tight text-ink-primary sm:text-[28px]">{p.ctaTitulo}</h2>
      <p class="mx-auto mt-3 max-w-md text-[16px] leading-relaxed text-ink-secondary">{p.ctaTexto}</p>
      <div class="mt-8 flex justify-center">
        <Boton href={WHATSAPP_URL} tamano="lg">{p.ctaBoton}</Boton>
      </div>
    </div>
  </article>
</Base>
