---
import Base from '../layouts/Base.astro'
import {
  IconAlert,
  IconBox,
  IconBolt,
  IconChart,
  IconInbox,
  IconLayers,
  IconNote,
  IconShield,
  IconSparkles,
  IconTag,
  IconUsers,
  IconWhatsApp,
} from '../components/icons.jsx'
import { PRODUCTO_COLUMNAS, PRODUCTO_PAGINAS } from '../data/producto'
import { getLocale, t, pathFor } from '../i18n/utils'
import { origenDe, urlCanonico } from '../lib/seo'

const ICONOS = {
  inbox: IconInbox,
  tag: IconTag,
  note: IconNote,
  sparkles: IconSparkles,
  bolt: IconBolt,
  layers: IconLayers,
  box: IconBox,
  chart: IconChart,
  alert: IconAlert,
  whatsapp: IconWhatsApp,
  users: IconUsers,
  shield: IconShield,
}

const lang = getLocale(Astro)
const p = t(lang).producto
const indice = p.indice
const canonica = urlCanonico(Astro.url.pathname, Astro.site).href

const columnas = PRODUCTO_COLUMNAS.map((columna) => ({
  id: columna.id,
  titulo: p.columnas[columna.id],
  paginas: columna.slugs.map((slug) => {
    const meta = PRODUCTO_PAGINAS.find((item) => item.slug === slug)
    const pagina = p.paginas[slug]
    return {
      slug,
      href: pathFor(lang, `/producto/${slug}`),
      nombre: pagina.nombre,
      menu: pagina.menu,
      Icono: ICONOS[meta.icono],
    }
  }),
}))

const origen = origenDe(Astro.site)
const ESQUEMA = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: indice.title,
      description: indice.description,
      url: canonica,
      inLanguage: lang === 'en' ? 'en' : 'es',
      isPartOf: { '@id': `${origen}/#aplicacion` },
      about: { '@id': `${origen}/#org` },
      hasPart: columnas.flatMap((columna) =>
        columna.paginas.map((pagina) => ({
          '@type': 'WebPage',
          name: pagina.nombre,
          url: urlCanonico(pagina.href, Astro.site).href,
        })),
      ),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Conext',
          item: urlCanonico(pathFor(lang, '/'), Astro.site).href,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: indice.nombre,
          item: canonica,
        },
      ],
    },
  ],
}
---

<Base title={indice.title} description={indice.description}>
  <script type="application/ld+json" set:html={JSON.stringify(ESQUEMA)} />

  <article class="contenedor pb-24 pt-14 sm:pb-32 sm:pt-20">
    <div>
      <p class="text-[12px] font-semibold uppercase tracking-[0.12em] text-violet">{indice.etiqueta}</p>
      <h1
        class="mt-3 max-w-3xl text-balance text-[32px] font-medium leading-[1.12] tracking-tight text-ink-primary sm:text-[44px] lg:text-[52px] lg:leading-[1.08]"
      >
        {indice.titulo}
      </h1>
      <p class="mt-4 max-w-xl text-[19px] font-normal leading-[28px] text-ink-secondary">
        {indice.bajada}
      </p>
      {
        indice.intro && (
          <p class="mt-5 max-w-2xl text-[16px] leading-[1.7] text-ink-secondary">{indice.intro}</p>
        )
      }
    </div>

    <div class="mt-16 grid grid-cols-1 gap-14 sm:grid-cols-2 xl:grid-cols-4 xl:gap-10">
      {
        columnas.map((columna) => (
          <section id={columna.id} class="min-w-0">
            <h2 class="text-[13px] font-medium text-ink-muted">{columna.titulo}</h2>
            <ul class="mt-4 space-y-1">
              {columna.paginas.map(({ href, nombre, menu, Icono }) => (
                <li>
                  <a
                    href={href}
                    class="group flex items-start gap-3 rounded-xl p-2 transition-colors duration-150 hover:bg-surface-hover"
                  >
                    {Icono && (
                      <span class="mt-px grid h-8 w-8 shrink-0 place-items-center rounded-[10px] border border-tint/[0.08] bg-tint/[0.03] text-ink-muted transition-colors duration-150 group-hover:border-violet/30 group-hover:bg-violet-soft group-hover:text-violet">
                        <Icono size={16} />
                      </span>
                    )}
                    <span class="min-w-0">
                      <span class="block text-[14px] font-medium leading-5 text-ink-primary">{nombre}</span>
                      <span class="mt-0.5 block text-[12.5px] leading-[1.35] text-ink-muted">{menu}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </article>
</Base>
