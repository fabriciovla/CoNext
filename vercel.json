{
  "framework": null,
  "installCommand": "npm install && npm install --include=dev --prefix site",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.conext.lat" }],
      "destination": "https://conext.lat/:path*",
      "statusCode": 308
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap-index.xml",
      "statusCode": 301
    },
    {
      "source": "/es",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/es/:path*",
      "destination": "/:path*",
      "statusCode": 301
    },
    {
      "source": "/clientes",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/en/clientes",
      "destination": "/en",
      "statusCode": 301
    },
    {
      "source": "/home",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/en/home",
      "destination": "/en",
      "statusCode": 301
    },
    {
      "source": "/feed",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/en/feed",
      "destination": "/en",
      "statusCode": 301
    },
    {
      "source": "/comments/feed",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/en/comments/feed",
      "destination": "/en",
      "statusCode": 301
    }
  ],
  "rewrites": [{ "source": "/app/:path*", "destination": "/app/index.html" }],
  "headers": [
    {
      "source": "/app",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/app/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/llms.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/llms-full.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/en/llms.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/en/llms-full.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    }
  ]
}
